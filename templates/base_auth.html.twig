{% set covers = [
    'build/images/cover1.webp',
    'build/images/cover2.webp',
    'build/images/cover3.webp',
    'build/images/cover4.webp',
] %}
{% set cover = covers[('now'|date('z')) % covers|length] %}

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

        <link rel="icon" type="image/png" href="{{ asset('build/images/favicon.png')}}">

        <title>{% block title %}Aviron Tours Métropole{% endblock %}</title>

        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
            <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"></script>
        {% endblock %}
    </head>

    <body class="auth-page" style="--auth-cover: url('{{ preload(asset(cover), { as: 'image' }) }}')">
        <div class="auth-shell">
            <a class="auth-brand" href="{{ path('homepage') }}">
                <img src="{{ asset('build/images/logo_white.svg') }}" width="160" height="72" alt="Aviron Tours Métropole"/>
            </a>

            <main class="auth-card">
                <div class="mb-4">
                    <h1 class="fs-4 mb-1">{% block heading %}{% endblock %}</h1>

                    {% if block('subtitle')|trim is not empty %}
                        <p class="text-secondary mb-0">{% block subtitle %}{% endblock %}</p>
                    {% endif %}
                </div>

                {% for label, messages in app.flashes(['success', 'info', 'warning', 'danger']) %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }} alert-dismissible" role="alert">
                            {{ message|trans }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                        </div>
                    {% endfor %}
                {% endfor %}

                {% block body %}{% endblock %}

                <p class="auth-legal border-top pt-3 mb-0 text-center small">
                    <a class="link-secondary" href="{{ path('legal_notice') }}">Mentions légales</a>
                </p>
            </main>
        </div>
    </body>
</html>
