{% extends 'layouts/app.html.twig' %}

{% block title %}1RM{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('my_space') }}">Mon espace</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>1RM</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}1RM{% endblock %}

{% block page_actions %}
    <twig:Button variant="secondary" outline size="sm" href="{{ path('sport_profile_workout_maximum_load') }}">
        <twig:ux:icon name="mdi:pencil" /> Modifier
    </twig:Button>
{% endblock %}

{% block body %}
    {% set load = app.user.workoutMaximumLoad %}

    {% set columns = [
        { label: '100%', factor: 1 },
        { label: '90%', factor: 0.9 },
        { label: '80%', factor: 0.8 },
        { label: '70%', factor: 0.7 },
        { label: '60%', factor: 0.6 },
        { label: '50%', factor: 0.5 },
        { label: '45%', factor: 0.45 },
        { label: '40%', factor: 0.4 },
        { label: '30%', factor: 0.3 },
    ] %}

    <twig:Card elevated>
        <twig:Card:Body padding="none">
            {% if load is not null %}
                {% set exercises = [
                    { name: 'Tirade rowing', max: load.rowingTirage, bar: 10 },
                    { name: 'Développé couché', max: load.benchPress, bar: 10 },
                    { name: 'Squat', max: load.squat, bar: 20 },
                    { name: 'Presse', max: load.legPress, bar: null },
                    { name: 'Epaulé', max: load.clean, bar: 10 },
                ] %}

                <twig:Table :stack="false" :hover="false">
                    <twig:Table:Head>
                        <twig:Table:Row>
                            <twig:Table:HeadCell>Exercice</twig:Table:HeadCell>

                            {% for column in columns %}
                                <twig:Table:HeadCell>{{ column.label }}</twig:Table:HeadCell>
                            {% endfor %}
                        </twig:Table:Row>
                    </twig:Table:Head>

                    <twig:Table:Body>
                        {% for exercise in exercises %}
                            <twig:Table:Row>
                                <twig:Table:RowHeader>
                                    {{ exercise.name }}

                                    {% if exercise.bar is not null %}
                                        <br><span class="fw-normal">Barre de {{ exercise.bar }}&nbsp;kg</span>
                                    {% endif %}
                                </twig:Table:RowHeader>

                                {% for column in columns %}
                                    {% set total = exercise.max * column.factor %}
                                    {% set perSide = exercise.bar is not null ? (total - exercise.bar) / 2 : null %}

                                    <twig:Table:Cell :label="column.label">
                                        <span>
                                            {{ total|format_number({max_fraction_digit: 1}) }}

                                            {# Below the bar's own weight there is nothing left to load. #}
                                            {% if perSide is not null and perSide > 0 %}
                                                <br><small class="app-load-per-side text-body-secondary">{{ perSide|format_number({max_fraction_digit: 1}) }} par côté</small>
                                            {% endif %}
                                        </span>
                                    </twig:Table:Cell>
                                {% endfor %}
                            </twig:Table:Row>
                        {% endfor %}
                    </twig:Table:Body>
                </twig:Table>
            {% else %}
                <twig:EmptyState text="Pas de données" />
            {% endif %}
        </twig:Card:Body>
    </twig:Card>
{% endblock %}
