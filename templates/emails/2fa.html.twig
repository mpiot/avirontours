{% extends 'emails/base.html.twig' %}

{% block preheader %}Votre code de connexion à usage unique.{% endblock %}

{% block heading %}Votre code de connexion{% endblock %}

{% block body %}
    <p>
        Bonjour {{ user.fullName }},<br/>
        Voici votre code d'authentification à usage unique&nbsp;:
    </p>

    <p class="code text-center">{{ user.emailAuthCode }}</p>

    <p class="small">
        Si vous n'êtes pas à l'origine de cette connexion, ignorez cet email et changez votre mot de passe.
    </p>
{% endblock %}
