{% extends 'emails/base.html.twig' %}

{% block preheader %}Votre lien de réinitialisation expire dans {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.{% endblock %}

{% block heading %}Réinitialiser votre mot de passe{% endblock %}

{% block body %}
    <p>
        Bonjour {{ user.fullName }},<br/>
        Nous avons bien reçu votre demande de modification de mot de passe. Cliquez sur le bouton ci-dessous pour modifier ce dernier.
    </p>

    <center>
        <button href="{{ url('app_reset_password', {token: resetToken.token}) }}">Modifier mon mot de passe</button>
    </center>

    <p class="small">
        Ce lien expire dans {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
        Si vous n'êtes pas à l'origine de cette demande, ignorez cet email&nbsp;: votre mot de passe reste inchangé.
    </p>
{% endblock %}
