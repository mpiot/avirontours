                    <twig:Table:Cell label="En savoir plus">
                        <a href="https://www.maif.fr/annexes/mentions-legales/donnees-personnelles" target="_blank" rel="noopener">maif.fr<span class="visually-hidden"> (nouvelle fenêtre)</span></a>
                    </twig:Table:Cell>
                </twig:Table:Row>
