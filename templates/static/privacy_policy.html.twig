                </twig:Table:Row>
                <twig:Table:Row>
                    <twig:Table:RowHeader>Aptitude médicale — membres majeurs</twig:Table:RowHeader>
                    <twig:Table:Cell label="Base légale">Exécution du contrat&nbsp;: la licence est conditionnée par le règlement médical de la Fédération Française d’Aviron</twig:Table:Cell>
