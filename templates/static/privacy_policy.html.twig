{% block main %}
    <p class="form-text">Dernière mise à jour&nbsp;: 11 août 2026</p>

    <p>
        Cette page décrit les données que l’association Aviron Tours Métropole traite dans le cadre de
        <a href="https://my.avirontours.fr">my.avirontours.fr</a>, pourquoi elle les traite, à qui elles sont
        transmises et quels droits vous pouvez exercer.
    </p>

    <section id="responsable" class="app-legal-anchor">
        <h2 class="fs-5 mt-4">Responsable du traitement</h2>
        <p>
            Association Aviron Tours Métropole, représentée par son président<br>
            5, avenue de Florence — 37000 Tours<br>
            Courriel&nbsp;: <a href="mailto:contact@avirontours.fr">contact@avirontours.fr</a>
        </p>

        <p>
            L’association n’a pas désigné de délégué à la protection des données&nbsp;: le traitement de données n’est
            ni son activité principale, ni mis en œuvre à grande échelle. Vos demandes sont traitées par le bureau, à
            l’adresse ci-dessus.
        </p>
    </section>

    <section id="donnees" class="app-legal-anchor">
        <h2 class="fs-5 mt-4">Données que nous traitons</h2>

        <twig:Table :hover="false">
            <twig:Table:Head>
                <twig:Table:Row>
                    <twig:Table:HeadCell>Catégorie</twig:Table:HeadCell>
                    <twig:Table:HeadCell>Données</twig:Table:HeadCell>
                </twig:Table:Row>
            </twig:Table:Head>
            <twig:Table:Body>
                <twig:Table:Row>
                    <twig:Table:RowHeader>Identité et coordonnées</twig:Table:RowHeader>
                    <twig:Table:Cell label="Données">Nom, prénom, sexe, date de naissance, nationalité, adresse postale, courriel, téléphone</twig:Table:Cell>
                </twig:Table:Row>
                <twig:Table:Row>
                    <twig:Table:RowHeader>Licence et paiements</twig:Table:RowHeader>
                    <twig:Table:Cell label="Données">Saison, catégorie, numéro de licence, état de validation, montants et moyens de paiement</twig:Table:Cell>
                </twig:Table:Row>
                <twig:Table:Row>
                    <twig:Table:RowHeader>Aptitude médicale</twig:Table:RowHeader>
                    <twig:Table:Cell label="Données">Type de justificatif (certificat ou attestation), niveau de pratique, date, document fourni</twig:Table:Cell>
                </twig:Table:Row>
                <twig:Table:Row>
                    <twig:Table:RowHeader>Suivi sportif <span class="fw-normal">(facultatif)</span></twig:Table:RowHeader>
                    <twig:Table:Cell label="Données">Taille, poids, mesures physiologiques, fréquences cardiaques, entraînements et séances</twig:Table:Cell>
                </twig:Table:Row>
                <twig:Table:Row>
                    <twig:Table:RowHeader>Activité</twig:Table:RowHeader>
                    <twig:Table:Cell label="Données">Sorties en bateau&nbsp;: date, horaires, distance, équipiers</twig:Table:Cell>
                </twig:Table:Row>
                <twig:Table:Row>
                    <twig:Table:RowHeader>Représentants légaux</twig:Table:RowHeader>
                    <twig:Table:Cell label="Données">Nom, prénom, courriel, téléphone</twig:Table:Cell>
                </twig:Table:Row>
                <twig:Table:Row>
                    <twig:Table:RowHeader>Données techniques</twig:Table:RowHeader>
                    <twig:Table:Cell label="Données">Journaux de connexion, cookies</twig:Table:Cell>
                </twig:Table:Row>
            </twig:Table:Body>
        </twig:Table>
    </section>

    <section id="finalites" class="app-legal-anchor">
        <h2 class="fs-5 mt-4">Finalités et bases légales</h2>

        <twig:Table :hover="false">
            <twig:Table:Head>
                <twig:Table:Row>
                    <twig:Table:HeadCell>Finalité</twig:Table:HeadCell>
