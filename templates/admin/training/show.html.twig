{% extends 'layouts/app.html.twig' %}

{% block title %}{{ training.trainedAt|format_date('short') }} - {{ training.sport.label }}{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('admin_home') }}">Administration</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item href="{{ path('admin_training_index') }}">Suivi des entraînements</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item href="{{ path('admin_training_list', { user_id: user.id }) }}">{{ user.fullname }}</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>{{ training.trainedAt|format_date('short') }} - {{ training.sport.label }}</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}{{ training.sport.label }} <small class="fs-6 text-body-secondary">{{ training.trainedAt|format_date('short') }}</small>{% endblock %}

{% block body %}
    {{ include('training/_show.html.twig') }}
{% endblock %}
