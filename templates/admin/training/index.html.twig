{% extends 'layouts/app.html.twig' %}

{% block title %}Suivi des entraînements{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('admin_home') }}">Administration</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>Suivi des entraînements</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}Suivi des entraînements{% endblock %}

{% block body %}
    {% set isFiltered = ['from', 'to', 'group', 'q']|filter(key => app.request.query.has(key))|length > 0 %}

    <twig:Card elevated>
        <twig:Card:Header>
            {% set today = date('now')|date('Y-m-d') %}

            <form class="row gx-3 gy-2 align-items-end" method="get">
                <div class="col-6 col-md-3">
                    <twig:Label for="from">Du</twig:Label>
                    <twig:Input type="date" id="from" name="from" :value="from|date('Y-m-d')" :max="today" />
                </div>

                <div class="col-6 col-md-3">
                    <twig:Label for="to">Au</twig:Label>
                    <twig:Input type="date" id="to" name="to" :value="to|date('Y-m-d')" :max="today" />
                </div>

                <div class="col-12 col-md-3">
                    <twig:Label for="group">Groupe</twig:Label>
                    <twig:Select id="group" name="group">
                        <option value="">Tous les groupes</option>
                        {% for groupChoice in groups %}
                            <option value="{{ groupChoice.id }}" {{ groupChoice == group ? 'selected' }}>{{ groupChoice.name }}</option>
                        {% endfor %}
                    </twig:Select>
                </div>

                <div class="col-12 col-md-3">
                    <twig:Label for="q">Membre</twig:Label>
                    <twig:Input
                        type="search"
                        id="q"
                        name="q"
                        placeholder="Rechercher un membre…"
                        :value="app.request.query.get('q') ?? ''"
                    />
                </div>

                <div class="col-12 d-flex flex-wrap gap-2">
                    <twig:Button variant="primary" size="sm">
                        <twig:ux:icon name="mdi:magnify" /> Filtrer
                    </twig:Button>

                    {% if isFiltered %}
                        <twig:Button variant="secondary" outline size="sm" href="{{ path('admin_training_index') }}">
                            <twig:ux:icon name="mdi:eraser" /> Réinitialiser les filtres
                        </twig:Button>
                    {% endif %}
                </div>
            </form>
        </twig:Card:Header>

        <twig:Card:Body padding="none">
            <twig:Table>
                <twig:Table:Head>
                    <twig:Table:Row>
                        <twig:Table:HeadCell>Membre</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Nombre de séances</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Distance</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Sensation</twig:Table:HeadCell>
                    </twig:Table:Row>
                </twig:Table:Head>
                <twig:Table:Body>
                    {% for user in users %}
                        <twig:Table:Row>
                            <twig:Table:RowHeader>
                                <a href="{{ path('admin_training_list', { user_id: user.id }) }}" class="stretched-link">
                                    {{ user.fullname }}
                                </a>
                            </twig:Table:RowHeader>
                            <twig:Table:Cell label="Nombre de séances">{{ user.trainings|length }}</twig:Table:Cell>
                            <twig:Table:Cell label="Distance">
                                {% set distance = user.trainings
                                    |filter(training => training.distance is not null and (constant('App\\Enum\\SportType::Rowing') == training.sport or constant('App\\Enum\\SportType::Ergometer') == training.sport))
                                    |reduce((carry, training, key) => carry + training.distance, 0)
                                %}

                                {{ (distance / 1000)|format_number({fraction_digit: 0}) }} km
                            </twig:Table:Cell>
                            <twig:Table:Cell label="Sensation">
                                {% set ratedTrainings = user.trainings|filter(training => training.feeling is not null) %}

                                {% if ratedTrainings is empty %}
                                    <twig:NoValue label="Aucune séance notée" />
                                {% else %}
                                    {% set feeling = (ratedTrainings|reduce((carry, training) => carry + training.feeling.value, 0) / ratedTrainings|length)|round %}
                                    {% set feelingTone = feeling < 40 ? 'danger' : (feeling < 60 ? 'warning' : 'success') %}

                                    <div class="d-flex align-items-center gap-2 flex-grow-1">
                                        <twig:Progress
                                            label="Sensation moyenne"
                                            :value="feeling"
                                            :tone="feelingTone"
                                            class="flex-grow-1"
                                        />

                                        <span class="text-nowrap">{{ feeling }}&nbsp;%</span>
                                    </div>
                                {% endif %}
                            </twig:Table:Cell>
                        </twig:Table:Row>
                    {% else %}
                        <twig:Table:Row>
                            <twig:Table:Cell span>
                                <twig:EmptyState :text="isFiltered ? 'Aucun entraînement ne correspond à ces filtres' : 'Aucun entraînement sur cette période'" />
                            </twig:Table:Cell>
                        </twig:Table:Row>
                    {% endfor %}
                </twig:Table:Body>
            </twig:Table>
        </twig:Card:Body>
    </twig:Card>
{% endblock %}
