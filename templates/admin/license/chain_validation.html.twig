{% extends 'layouts/app.html.twig' %}

{% block title %}Validation des certificats médicaux de la saison {{ season.name }}{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('admin_home') }}">Administration</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item href="{{ path('season_index') }}">Gestion des saisons</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item href="{{ path('season_show', { 'id': season.id }) }}">{{ season.name }}</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>Validation des certificats médicaux de la saison {{ season.name }}</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}Validation des certificats médicaux de la saison {{ season.name }}{% endblock %}

{% block body %}
    <twig:Card elevated>
        <twig:Card:Body>
            {% if license is not null %}
                <div class="row">
                    <div class="col-lg-8">
                        {% if license.medicalCertificate.uploadedFile.mimeType|u.containsAny('image/') %}
                            <img src="{{ path('medical_certificate_download', { 'id': license.medicalCertificate.id }) }}" alt="Certificat médical" class="img-fluid">
                        {% else %}
                            <object data="{{ path('medical_certificate_download', { 'id': license.medicalCertificate.id }) }}" type="application/pdf" class="w-100 vh-100">Certificat médical</object>
                        {% endif %}
                    </div>

                    <div class="col-lg-4 mt-3 mt-lg-0">
                        <twig:Card>
                            <twig:Card:Header>
                                Informations membre
                            </twig:Card:Header>

                            <twig:Card:Body>
                                Nom Prénom&nbsp;: {{ license.user.fullName }}<br>
                                Date de naissance&nbsp;: {{ license.user.birthday|format_date('short') }} ({{ license.user.age }} ans)
                            </twig:Card:Body>
                        </twig:Card>

                        {% for previous_licence in previous_licences %}
                            <twig:Card class="mt-3">
                                <twig:Card:Header>
                                    Saison {{ previous_licence.seasonCategory.season.name }}
                                </twig:Card:Header>

                                <twig:Card:Body>
                                    Date du certificat&nbsp;: {{ previous_licence.medicalCertificate.date|format_date('short') }}<br>
                                    Type de certificat&nbsp;: {{ previous_licence.medicalCertificate.type.label }}<br>
                                    Niveau de certificat&nbsp;: {{ previous_licence.medicalCertificate.level.label }}
                                </twig:Card:Body>
                            </twig:Card>
                        {% endfor %}

                        <twig:Card tone="primary" class="mt-3">
                            <twig:Card:Header>
                                Saison {{ license.seasonCategory.season.name }}

                                <twig:block name="actions">
                                    <twig:Button variant="secondary" outline size="sm" href="{{ path('license_edit', { 'seasonId': license.seasonCategory.season.id, id: license.id }) }}" aria-label="Modifier la licence">
                                        <twig:ux:icon name="mdi:pencil" />
                                    </twig:Button>
                                </twig:block>
                            </twig:Card:Header>

                            <twig:Card:Body>
                                Date du certificat&nbsp;: {{ license.medicalCertificate.date|format_date('short') }}<br>
                                Type de certificat&nbsp;: {{ license.medicalCertificate.type.label }}<br>
                                Niveau de certificat&nbsp;: {{ license.medicalCertificate.level.label }}
                            </twig:Card:Body>
                        </twig:Card>

                        <div class="mt-3">
                            <div class="d-grid gap-2">
                                {% if workflow_can(license, 'validate_medical_certificate') %}
                                    <form
                                        method="post"
                                        action="{{ path('license_medical_certificate_action', { seasonId: season.id, id: license.id, transitionName: 'validate' }) }}"
                                        class="d-grid"
                                    >
                                        <input type="hidden" name="_token" data-controller="csrf-protection" value="{{ csrf_token('submit') }}">
                                        <twig:Button variant="primary">
                                            Valider le certificat médical
                                        </twig:Button>
                                    </form>
                                {% endif %}

                                {% if workflow_can(license, 'reject_medical_certificate') %}
                                    <form
                                        method="post"
                                        action="{{ path('license_medical_certificate_action', { seasonId: season.id, id: license.id, transitionName: 'reject' }) }}"
                                        class="d-grid"
                                    >
                                        <input type="hidden" name="_token" data-controller="csrf-protection" value="{{ csrf_token('submit') }}">
                                        <twig:Button variant="warning">
                                            Rejeter le certificat médical
                                        </twig:Button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <twig:Alert tone="info" icon :live="false">Il n'y a pas de license à valider.</twig:Alert>
            {% endif %}
        </twig:Card:Body>
    </twig:Card>
{% endblock %}
