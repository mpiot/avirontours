{% extends 'layouts/app.html.twig' %}
{% form_theme form 'admin/license/_form_theme.html.twig' %}

{% block title %}Valider un paiement{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('admin_home') }}">Administration</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item href="{{ path('user_index') }}">Gestion des saisons</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item href="{{ path('season_show', { 'id': license.seasonCategory.season.id }) }}">{{ license.seasonCategory.season.name }}</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item href="{{ path('user_show', { 'id': license.user.id }) }}">{{ license.user.fullName }}</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>Valider un paiement</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}Valider le paiement de {{ license.user.fullName }}{% endblock %}

{% block body %}
    <twig:Card elevated>
        <twig:Card:Body>
            {{ include('admin/license/_form.html.twig', {'button_label': 'Valider le paiement'}) }}
        </twig:Card:Body>
    </twig:Card>
{% endblock %}
