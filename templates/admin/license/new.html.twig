{% extends 'layouts/app.html.twig' %}
{% form_theme form 'admin/license/_form_theme.html.twig' %}

{% block title %}Ajouter une licence{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('admin_home') }}">Administration</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item href="{{ path('season_index') }}">Gestion des saisons</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item href="{{ path('season_show', { 'id': season.id }) }}">{{ season.name }}</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>Ajouter une licence</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}Ajouter une licence{% endblock %}

{% block body %}
    <twig:FormCard>
        {{ include('admin/license/_form.html.twig') }}
    </twig:FormCard>
{% endblock %}
