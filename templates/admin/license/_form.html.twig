{{ form_start(form) }}
    <div class="row">
        {% if form.user is defined %}
            <div class="col-md">
                {{ form_row(form.user) }}
            </div>
        {% endif %}

        {% if form.seasonCategory is defined %}
            <div class="col-md">
                {{ form_row(form.seasonCategory) }}
            </div>
        {% endif %}
    </div>

    {% if form.logbookEntryLimit is defined %}
        {{ form_row(form.logbookEntryLimit) }}
    {% endif %}

    {% if form.medicalCertificate is defined %}
        <twig:Card class="mb-3">
            <twig:Card:Header>
                Certificat Médical
            </twig:Card:Header>

            <twig:Card:Body>
                <div class="row">
                    <div class="col-md">
                        {{ form_row(form.medicalCertificate.type, { label_attr: { class: 'radio-inline' } }) }}
                    </div>

                    <div class="col-md">
                        {{ form_row(form.medicalCertificate.level, { label_attr: { class: 'radio-inline' } }) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md">
                        {{ form_row(form.medicalCertificate.date) }}
                    </div>

                    <div class="col-md">
                        {{ form_row(form.medicalCertificate.file) }}
                    </div>
                </div>
            </twig:Card:Body>
        </twig:Card>
    {% endif %}

    {% if form.payments is defined %}
        <twig:Card class="mb-3">
            <twig:Card:Header>
                 Paiements
            </twig:Card:Header>

            <twig:Card:Body data-controller="dependent-field">
                {{ form_row(form.payments) }}
            </twig:Card:Body>
        </twig:Card>
    {% endif %}

    {% if form.optionalInsurance is defined %}
        {{ form_row(form.optionalInsurance, {
            'help': '<a href="'~ asset('files/maif-garanties-assurance.pdf') ~'" target="_blank" rel="noopener">Télécharger la notice</a>',
            'help_html': true,
        }) }}
        {{ form_row(form.federationEmailAllowed) }}
    {% endif %}

    <twig:Button variant="primary" class="mt-3">{{ button_label|default('Enregistrer') }}</twig:Button>
{{ form_end(form) }}
