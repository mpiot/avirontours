{% extends 'layouts/app.html.twig' %}

{% block title %}Gestion des groupes{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('admin_home') }}">Administration</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>Gestion des groupes</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}Gestion des groupes{% endblock %}

{% block page_actions %}
    <twig:Button variant="primary" outline size="sm" href="{{ path('group_new') }}">
        <twig:ux:icon name="mdi:plus" /> Ajouter un groupe
    </twig:Button>
{% endblock %}

{% block body %}
    <twig:Card elevated>
        <twig:Card:Body padding="none">
            <twig:Table>
                <twig:Table:Head>
                    <twig:Table:Row>
                        <twig:Table:HeadCell>Nom</twig:Table:HeadCell>
                        <twig:Table:HeadCell><span class="visually-hidden">Actions</span></twig:Table:HeadCell>
                    </twig:Table:Row>
                </twig:Table:Head>
                <twig:Table:Body>
                    {% for group in groups %}
                        <twig:Table:Row>
                            <twig:Table:RowHeader>
                                <a href="{{ path('group_show', {'id': group.id}) }}" class="stretched-link">{{ group.name }}</a>
                            </twig:Table:RowHeader>
                            <twig:Table:Cell actions>
                                <twig:Button variant="secondary" outline size="sm" href="{{ path('group_edit', {'id': group.id}) }}">
                                    <twig:ux:icon name="mdi:pencil" /> Modifier
                                </twig:Button>
                            </twig:Table:Cell>
                        </twig:Table:Row>
                    {% else %}
                        <twig:Table:Row>
                            <twig:Table:Cell span><twig:EmptyState text="Pas de groupe" /></twig:Table:Cell>
                        </twig:Table:Row>
                    {% endfor %}
                </twig:Table:Body>
            </twig:Table>
        </twig:Card:Body>
    </twig:Card>
{% endblock %}
