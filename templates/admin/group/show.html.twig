{% extends 'layouts/app.html.twig' %}

{% block title %}{{ group.name }}{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('admin_home') }}">Administration</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item href="{{ path('group_index') }}">Gestion des groupes</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>{{ group.name }}</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}{{ group.name }}{% endblock %}

{% block page_actions %}
    <twig:DeleteForm :action="path('group_delete', {'id': group.id})">
        <twig:Button variant="secondary" outline href="{{ path('group_edit', {'id': group.id}) }}" aria-label="Modifier">
            <twig:ux:icon name="mdi:pencil" /> <span class="d-none d-sm-inline">Modifier</span>
        </twig:Button>
    </twig:DeleteForm>
{% endblock %}

{% block body %}
    <twig:Card elevated>
        <twig:Card:Header>
            Membres
        </twig:Card:Header>
        <twig:ListGroup flush>
            {% for member in group.members %}
                <twig:ListGroup:Item><a href="{{ path('user_show', { 'id': member.id }) }}">{{ member.fullName }}</a></twig:ListGroup:Item>
            {% endfor %}
        </twig:ListGroup>
    </twig:Card>
{% endblock %}
