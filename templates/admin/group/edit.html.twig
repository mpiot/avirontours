{% extends 'layouts/app.html.twig' %}

{% block title %}Modifier un groupe{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('admin_home') }}">Administration</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item href="{{ path('group_index') }}">Gestion des groupes</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item href="{{ path('group_show', {'id': group.id}) }}">{{ group.name }}</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>Modifier un groupe</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}Modifier un groupe{% endblock %}

{% block page_actions %}
    <twig:DeleteForm :action="path('group_delete', {'id': group.id})" />
{% endblock %}

{% block body %}
    <twig:FormCard>
        {{ include('admin/group/_form.html.twig') }}
    </twig:FormCard>
{% endblock %}
