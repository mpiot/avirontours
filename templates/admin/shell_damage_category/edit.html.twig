{% extends 'layouts/app.html.twig' %}

{% block title %}Modifier un bateau{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('admin_home') }}">Administration</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item href="{{ path('shell_damage_category_index') }}">Gestion des catégories d'avarie</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>Modifier une catégorie d'avarie</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}Modifier une catégorie d'avarie{% endblock %}

{% block page_actions %}
    <twig:DeleteForm :action="path('shell_damage_category_delete', {'id': shell_damage_category.id})" />
{% endblock %}

{% block body %}
    <twig:FormCard>
        {{ include('admin/shell_damage_category/_form.html.twig') }}
    </twig:FormCard>
{% endblock %}
