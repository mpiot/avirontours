{% extends 'layouts/app.html.twig' %}

{% block title %}Gestion des catégories d'avarie{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('admin_home') }}">Administration</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>Gestion des catégories d'avarie</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}Gestion des catégories d'avarie{% endblock %}

{% block page_actions %}
    <twig:Button variant="primary" outline size="sm" href="{{ path('shell_damage_category_new') }}">
        <twig:ux:icon name="mdi:plus" /> Ajouter une catégorie d'avarie
    </twig:Button>
{% endblock %}

{% block body %}
    <twig:Card elevated>
        <twig:Card:Body padding="none">
            <twig:Table>
                <twig:Table:Head>
                    <twig:Table:Row>
                        <twig:Table:HeadCell>Priorité</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Nom</twig:Table:HeadCell>
                        <twig:Table:HeadCell><span class="visually-hidden">Actions</span></twig:Table:HeadCell>
                    </twig:Table:Row>
                </twig:Table:Head>
                <twig:Table:Body>
                    {% for shell_damage_category in shell_damage_category_categories %}
                        <twig:Table:Row>
                            <twig:Table:Cell label="Priorité">
                                {% if constant('App\\Entity\\ShellDamageCategory::PRIORITY_HIGH') == shell_damage_category.priority  %}
                                    <twig:Badge tone="danger">Importante</twig:Badge>
                                {% else %}
                                    <twig:Badge tone="warning">Intermédiaire</twig:Badge>
                                {% endif %}
                            </twig:Table:Cell>
                            <twig:Table:Cell label="Nom">{{ shell_damage_category.name }}</twig:Table:Cell>
                            <twig:Table:Cell actions>
                                <twig:Button variant="secondary" outline size="sm" href="{{ path('shell_damage_category_edit', {'id': shell_damage_category.id}) }}">
                                    <twig:ux:icon name="mdi:pencil" /> Modifier
                                </twig:Button>
                            </twig:Table:Cell>
                        </twig:Table:Row>
                    {% else %}
                        <twig:Table:Row>
                            <twig:Table:Cell span><twig:EmptyState text="Pas de catégorie" /></twig:Table:Cell>
                        </twig:Table:Row>
                    {% endfor %}
                </twig:Table:Body>
            </twig:Table>
        </twig:Card:Body>
    </twig:Card>
{% endblock %}
