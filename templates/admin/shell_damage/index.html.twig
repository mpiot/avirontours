{% extends 'layouts/app.html.twig' %}

{% block title %}Gestion des avaries{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('admin_home') }}">Administration</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>Gestion des avaries</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}Gestion des avaries{% endblock %}

{% block page_actions %}
    <twig:Button variant="primary" outline size="sm" href="{{ path('shell_damage_new') }}">
        <twig:ux:icon name="mdi:plus" /> Ajouter une avarie
    </twig:Button>
{% endblock %}

{% block body %}
    <twig:Card elevated>
        <twig:Card:Body padding="none">
            <twig:Table>
                <twig:Table:Head>
                    <twig:Table:Row>
                        <twig:Table:HeadCell>Priorité</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Bateau</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Catégorie</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Description</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Créé le</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Début réparation</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Fin réparation</twig:Table:HeadCell>
                        {% if is_granted('ROLE_MATERIAL_ADMIN') %}
                            <twig:Table:HeadCell><span class="visually-hidden">Actions</span></twig:Table:HeadCell>
                        {% endif %}
                    </twig:Table:Row>
                </twig:Table:Head>
                <twig:Table:Body>
                    {% for shell_damage in shell_damages %}
                        <twig:Table:Row>
                            <twig:Table:Cell label="Priorité">
                                {% if shell_damage.repairEndAt %}
                                    <twig:Badge tone="success">Terminé</twig:Badge>
                                {% elseif constant('App\\Entity\\ShellDamageCategory::PRIORITY_HIGH') == shell_damage.category.priority  %}
                                    <twig:Badge tone="danger">Importante</twig:Badge>
                                {% else %}
                                    <twig:Badge tone="warning">Intermédiaire</twig:Badge>
                                {% endif %}
                            </twig:Table:Cell>
                            <twig:Table:Cell label="Bateau">
                                {{ shell_damage.shell.fullName }}
                                {% if shell_damage.logbookEntry %}
                                    <span {{ stimulus_controller('tooltip') }} title="{{ shell_damage.logbookEntry.fullCrew|join(', ') }}">
                                        <twig:ux:icon name="mdi:account-group" />
                                        <span class="visually-hidden">Équipage&nbsp;: {{ shell_damage.logbookEntry.fullCrew|join(', ') }}</span>
                                    </span>
                                {% endif %}
                            </twig:Table:Cell>
                            <twig:Table:Cell label="Catégorie">{{ shell_damage.category.name }}</twig:Table:Cell>
                            <twig:Table:Cell label="Description">
                                <span class="app-damage-description">{{ shell_damage.description }}</span>
                            </twig:Table:Cell>
                            <twig:Table:Cell label="Créé le">{{ shell_damage.createdAt|format_date('short') }}</twig:Table:Cell>
                            <twig:Table:Cell label="Début réparation">
                                {% if shell_damage.repairStartAt %}
                                    {{ shell_damage.repairStartAt|format_date('short') }}
                                {% else %}
                                    <twig:NoValue />
                                {% endif %}
                            </twig:Table:Cell>
                            <twig:Table:Cell label="Fin réparation">
                                {% if shell_damage.repairEndAt %}
                                    {{ shell_damage.repairEndAt|format_date('short') }}
                                {% else %}
                                    <twig:NoValue />
                                {% endif %}
                            </twig:Table:Cell>
                            {% if is_granted('ROLE_MATERIAL_ADMIN') %}
                                <twig:Table:Cell actions>
                                    <twig:Button variant="secondary" outline size="sm" href="{{ path('shell_damage_edit', {'id': shell_damage.id}) }}">
                                        <twig:ux:icon name="mdi:pencil" /> Modifier
                                    </twig:Button>
                                </twig:Table:Cell>
                            {% endif %}
                        </twig:Table:Row>
                    {% else %}
                        <twig:Table:Row>
                            <twig:Table:Cell span><twig:EmptyState text="Pas d'avarie" /></twig:Table:Cell>
                        </twig:Table:Row>
                    {% endfor %}
                </twig:Table:Body>
            </twig:Table>
        </twig:Card:Body>

        {% if shell_damages|length < shell_damages.totalItemCount %}
            <twig:Card:Footer>
                <twig:Pagination :pagination="shell_damages" />
            </twig:Card:Footer>
        {% endif %}
    </twig:Card>
{% endblock %}
