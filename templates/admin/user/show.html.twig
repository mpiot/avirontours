{% extends 'layouts/app.html.twig' %}

{% block title %}{{ user.fullName }}{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('admin_home') }}">Administration</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item href="{{ path('user_index') }}">Gestion des utilisateurs</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>{{ user.fullName }}</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}{{ user.fullName }}{% endblock %}

{% block page_actions %}
    <twig:DeleteForm :action="path('user_delete', {'id': user.id})">
        <twig:Button variant="secondary" outline href="{{ path('user_edit', {'id': user.id}) }}" aria-label="Modifier">
            <twig:ux:icon name="mdi:pencil" /> <span class="d-none d-sm-inline">Modifier</span>
        </twig:Button>
    </twig:DeleteForm>
{% endblock %}

{% block body %}
    <div class="row g-3">
        <div class="col-xl">
            <twig:Card>
                <twig:Card:Header>
                    Membre
                </twig:Card:Header>
                <twig:ListGroup flush>
                    <twig:ListGroup:Item label="Date d'inscription">{{ user.subscriptionDate|format_date('short') }}</twig:ListGroup:Item>
                    <twig:ListGroup:Item label="Nom d'utilisateur">{{ user.username }}</twig:ListGroup:Item>
                    <twig:ListGroup:Item label="Genre">{{ user.textGender }}</twig:ListGroup:Item>
                    <twig:ListGroup:Item label="Nom">{{ user.fullName }}</twig:ListGroup:Item>
                    <twig:ListGroup:Item label="Date de naissance">{{ user.birthday|format_date('short') }} ({{ user.age }} ans)</twig:ListGroup:Item>
                    <twig:ListGroup:Item label="Numéro de licence" :muted="user.licenseNumber is null">
                        {% if user.licenseNumber is not null %}
                            {{ user.licenseNumber }}
                        {% else %}
                            <twig:NoValue />
                        {% endif %}
                    </twig:ListGroup:Item>
                </twig:ListGroup>
            </twig:Card>
        </div>

        <div class="col-xl">
            <twig:Card>
                <twig:Card:Header>
                    Contact
                </twig:Card:Header>
                <twig:ListGroup flush>
                    <twig:ListGroup:Item label="Email">{{ user.email }}</twig:ListGroup:Item>
                    <twig:ListGroup:Item label="Numéro de téléphone">{{ user.phoneNumber }}</twig:ListGroup:Item>
                    <twig:ListGroup:Item label="Adresse">{{ user.formattedAddress }}</twig:ListGroup:Item>
                </twig:ListGroup>
            </twig:Card>
        </div>
    </div>

    <div class="row g-3 mt-0">
        <div class="col-xl">
            <twig:Card>
                <twig:Card:Header>
                    Responsable légal 1
                </twig:Card:Header>
                <twig:ListGroup flush>
                    <twig:ListGroup:Item label="Rôle">
                        {% if user.firstLegalGuardian %}
                            {{ user.firstLegalGuardian.role.label }}
                        {% else %}
                            <twig:NoValue />
                        {% endif %}
                    </twig:ListGroup:Item>
                    <twig:ListGroup:Item label="Prénom">
                        {% if user.firstLegalGuardian %}
                            {{ user.firstLegalGuardian.firstName }}
                        {% else %}
                            <twig:NoValue />
                        {% endif %}
                    </twig:ListGroup:Item>
                    <twig:ListGroup:Item label="Nom">
                        {% if user.firstLegalGuardian %}
                            {{ user.firstLegalGuardian.lastName }}
                        {% else %}
                            <twig:NoValue />
                        {% endif %}
                    </twig:ListGroup:Item>
                    <twig:ListGroup:Item label="Email">
                        {% if user.firstLegalGuardian %}
                            {{ user.firstLegalGuardian.email }}
                        {% else %}
                            <twig:NoValue />
                        {% endif %}
                    </twig:ListGroup:Item>
                    <twig:ListGroup:Item label="Numéro de téléphone">
                        {% if user.firstLegalGuardian %}
                            {{ user.firstLegalGuardian.phoneNumber }}
                        {% else %}
                            <twig:NoValue />
                        {% endif %}
                    </twig:ListGroup:Item>
                </twig:ListGroup>
            </twig:Card>
        </div>

        <div class="col-xl">
            <twig:Card>
                <twig:Card:Header>
                    Responsable légal 2
                </twig:Card:Header>
                <twig:ListGroup flush>
                    <twig:ListGroup:Item label="Rôle">
                        {% if user.secondLegalGuardian %}
                            {{ user.secondLegalGuardian.role.label }}
                        {% else %}
                            <twig:NoValue />
                        {% endif %}
                    </twig:ListGroup:Item>
                    <twig:ListGroup:Item label="Prénom">
                        {% if user.secondLegalGuardian %}
                            {{ user.secondLegalGuardian.firstName }}
                        {% else %}
                            <twig:NoValue />
                        {% endif %}
                    </twig:ListGroup:Item>
                    <twig:ListGroup:Item label="Nom">
                        {% if user.secondLegalGuardian %}
                            {{ user.secondLegalGuardian.lastName }}
                        {% else %}
                            <twig:NoValue />
                        {% endif %}
                    </twig:ListGroup:Item>
                    <twig:ListGroup:Item label="Email">
                        {% if user.secondLegalGuardian %}
                            {{ user.secondLegalGuardian.email }}
                        {% else %}
                            <twig:NoValue />
                        {% endif %}
                    </twig:ListGroup:Item>
                    <twig:ListGroup:Item label="Numéro de téléphone">
                        {% if user.secondLegalGuardian %}
                            {{ user.secondLegalGuardian.phoneNumber }}
                        {% else %}
                            <twig:NoValue />
                        {% endif %}
                    </twig:ListGroup:Item>
                </twig:ListGroup>
            </twig:Card>
        </div>
    </div>

    <twig:Card class="mt-3">
        <twig:Card:Header>
            Licences
        </twig:Card:Header>
        <twig:Card:Body padding="none">
            <twig:Table>
                <twig:Table:Head>
                    <twig:Table:Row>
                        <twig:Table:HeadCell>Saison</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Type</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Niveau</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Statut</twig:Table:HeadCell>
                    </twig:Table:Row>
                </twig:Table:Head>
                <twig:Table:Body>
                    {% for license in user.licenses %}
                        <twig:Table:Row>
                            <twig:Table:Cell label="Saison">{{ license.seasonCategory.season.name }} - {{ license.seasonCategory.name }}</twig:Table:Cell>
                            <twig:Table:Cell label="Type">{{ license.medicalCertificate.type.label }}</twig:Table:Cell>
                            <twig:Table:Cell label="Niveau">{{ license.medicalCertificate.level.label }}</twig:Table:Cell>
                            <twig:Table:Cell label="Statut">
                                <ul class="app-license-states">
                                    {% for place in workflow_marked_places(license) %}
                                        <li class="app-license-state" data-tone="{{ workflow_metadata(license, 'badge', place) }}">
                                            {{- workflow_metadata(license, 'title', place) -}}
                                        </li>
                                    {% endfor %}
                                </ul>
                            </twig:Table:Cell>
                        </twig:Table:Row>
                    {% else %}
                        <twig:Table:Row>
                            <twig:Table:Cell span><twig:EmptyState text="Pas de licence" /></twig:Table:Cell>
                        </twig:Table:Row>
                    {% endfor %}
                </twig:Table:Body>
            </twig:Table>
        </twig:Card:Body>
    </twig:Card>

    <twig:Card class="mt-3">
        <twig:Card:Header>
            Groupes
        </twig:Card:Header>
        <twig:ListGroup flush>
            {% for group in user.groups %}
                <twig:ListGroup:Item><a href="{{ path('group_show', { 'id': group.id }) }}">{{ group.name }}</a></twig:ListGroup:Item>
            {% else %}
                <twig:ListGroup:Item>Pas de groupe</twig:ListGroup:Item>
            {% endfor %}
        </twig:ListGroup>
    </twig:Card>
{% endblock %}
