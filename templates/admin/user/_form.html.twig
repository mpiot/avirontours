<div {{ stimulus_controller('dependent-field') }}>
    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_row(form.subscriptionDate) }}

        <div class="row">
            <div class="col-xl mb-3">
                <twig:Card>
                    <twig:Card:Header>
                        Membre
                    </twig:Card:Header>
                    <twig:Card:Body>
                        {{ form_row(form.gender, { label_attr: { class: 'radio-inline' } }) }}

                        <div class="row">
                            <div class="col-md">
                                {{ form_row(form.firstName) }}
                            </div>
                            <div class="col-md">
                                {{ form_row(form.lastName) }}
                            </div>
                        </div>

                        {{ form_row(form.email) }}
                        {{ form_row(form.phoneNumber) }}

                        {% if form.roles is defined%}
                            {{ form_row(form.roles) }}
                        {% endif %}

                        <div class="row">
                            <div class="col-md">
                                {{ form_row(form.nationality) }}
                            </div>
                            <div class="col-md">
                                {{ form_row(form.birthday) }}
                            </div>
                        </div>
                    </twig:Card:Body>
                </twig:Card>
            </div>

            <div class="col-xl">
                <twig:Card class="mb-3">
                    <twig:Card:Header>
                        Adresse
                    </twig:Card:Header>
                    <twig:Card:Body>
                        <div class="row">
                            <div class="col-4">
                                {{ form_row(form.laneNumber) }}
                            </div>
                            <div class="col-8">
                                {{ form_row(form.laneType) }}
                            </div>
                            <div class="col-12">
                                {{ form_row(form.laneName) }}
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md">
                                {{ form_row(form.postalCode, { attr: { 'data-action': 'dependent-field#keyup' } }) }}
                            </div>
                            <div id="city-target" class="col-md" {{ stimulus_target('dependent-field', 'target') }}>
                                {{ form_row(form.city) }}
                            </div>
                        </div>
                    </twig:Card:Body>
                </twig:Card>

                <twig:Card class="mb-3">
                    <twig:Card:Header>
                        Autres
                    </twig:Card:Header>
                    <twig:Card:Body>
                        {{ form_row(form.licenseNumber) }}
                    </twig:Card:Body>
                </twig:Card>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-6 mb-3">
                <twig:Card>
                    <twig:Card:Header>
                        Responsable légal 1
                    </twig:Card:Header>
                    <twig:Card:Body>
                        {% include 'admin/user/_legal_guardian_form.html.twig' with { 'form': form.firstLegalGuardian } %}
                    </twig:Card:Body>
                </twig:Card>
            </div>

            <div class="col-lg-6 mb-3">
                <twig:Card>
                    <twig:Card:Header>
                        Responsable légal 2
                    </twig:Card:Header>
                    <twig:Card:Body>
                        {% include 'admin/user/_legal_guardian_form.html.twig' with { 'form': form.secondLegalGuardian } %}
                    </twig:Card:Body>
                </twig:Card>
            </div>
        </div>

        {{ form_row(form.clubEmailAllowed) }}

        <twig:Button variant="primary" class="mt-3">{{ button_label|default('Enregistrer') }}</twig:Button>
    {{ form_end(form) }}
</div>
