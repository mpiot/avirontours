{% extends 'layouts/app.html.twig' %}

{% block title %}Modifier un utilisateur{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('admin_home') }}">Administration</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item href="{{ path('user_index') }}">Gestion des utilisateurs</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item href="{{ path('user_show', { 'id': user.id }) }}">{{ user.fullName }}</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>Modifier un utilisateur</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}Modifier un utilisateur{% endblock %}

{% block page_actions %}
    <twig:DeleteForm :action="path('user_delete', {'id': user.id})" />
{% endblock %}

{% block body %}
    {# Not a FormCard: this form is a grid of cards, not a reading column. #}
    <twig:Card elevated>
        <twig:Card:Body>
            {{ include('admin/user/_form.html.twig') }}
        </twig:Card:Body>
    </twig:Card>
{% endblock %}
