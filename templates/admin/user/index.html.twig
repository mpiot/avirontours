{% extends 'layouts/app.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('admin_home') }}">Administration</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>Gestion des utilisateurs</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}Gestion des utilisateurs{% endblock %}

{% block page_actions %}
    <twig:Button variant="primary" outline size="sm" href="{{ path('user_new') }}">
        <twig:ux:icon name="mdi:plus" /> Ajouter un utilisateur
    </twig:Button>
{% endblock %}

{% block body %}
    {% set isSearching = app.request.query.get('q') is not empty %}

    <twig:Card elevated>
        <twig:Card:Header>
            <twig:SearchForm
                id="user-search"
                label="Rechercher un membre"
            />
        </twig:Card:Header>

        <twig:Card:Body padding="none">
            <twig:Table>
                <twig:Table:Head>
                    <twig:Table:Row>
                        <twig:Table:HeadCell>Nom</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Email</twig:Table:HeadCell>
                        <twig:Table:HeadCell><span class="visually-hidden">Actions</span></twig:Table:HeadCell>
                    </twig:Table:Row>
                </twig:Table:Head>
                <twig:Table:Body>
                    {% for user in users %}
                        <twig:Table:Row>
                            <twig:Table:RowHeader>
                                <a href="{{ path('user_show', {'id': user.id}) }}" class="stretched-link">{{ user.fullName }}</a>
                            </twig:Table:RowHeader>
                            <twig:Table:Cell label="Email"><a href="mailto:{{ user.email }}">{{ user.email }}</a></twig:Table:Cell>
                            <twig:Table:Cell actions>
                                {% if is_granted('ROLE_SUPER_ADMIN') %}
                                    <twig:Button variant="secondary" outline size="sm" href="{{ path('homepage', {'_switch_user': user.username}) }}">
                                        <twig:ux:icon name="mdi:account-switch" /> Prendre l'identité
                                    </twig:Button>
                                {% endif %}
                                <twig:Button variant="secondary" outline size="sm" href="{{ path('user_edit', {'id': user.id}) }}">
                                    <twig:ux:icon name="mdi:pencil" /> Modifier
                                </twig:Button>
                            </twig:Table:Cell>
                        </twig:Table:Row>
                    {% else %}
                        <twig:Table:Row>
                            <twig:Table:Cell span>
                                <twig:EmptyState :text="isSearching ? 'Aucun utilisateur ne correspond à cette recherche' : 'Pas d\'utilisateur'"/>
                            </twig:Table:Cell>
                        </twig:Table:Row>
                    {% endfor %}
                </twig:Table:Body>
            </twig:Table>
        </twig:Card:Body>

        {% if users|length < users.totalItemCount %}
            <twig:Card:Footer>
                <twig:Pagination :pagination="users" />
            </twig:Card:Footer>
        {% endif %}
    </twig:Card>
{% endblock %}
