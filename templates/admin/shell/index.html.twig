{% extends 'layouts/app.html.twig' %}

{% block title %}Gestion du parc{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('admin_home') }}">Administration</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>Gestion du parc</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}Gestion du parc{% endblock %}

{% block page_actions %}
    <twig:Button variant="primary" outline size="sm" href="{{ path('shell_new') }}">
        <twig:ux:icon name="mdi:plus" /> Ajouter un bateau
    </twig:Button>
{% endblock %}

{% block body %}
    <twig:Card elevated>
        <twig:Card:Body padding="none">
            <twig:Table>
                <twig:Table:Head>
                    <twig:Table:Row>
                        <twig:Table:HeadCell>Nom</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Type</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Porteur</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Kilométrage</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Actif</twig:Table:HeadCell>
                        <twig:Table:HeadCell><span class="visually-hidden">Actions</span></twig:Table:HeadCell>
                    </twig:Table:Row>
                </twig:Table:Head>
                <twig:Table:Body>
                    {% for shell in shells %}
                        <twig:Table:Row>
                            <twig:Table:RowHeader>
                                <a href="{{ path('shell_show', {'id': shell.id}) }}" class="stretched-link">{{ shell.name }}</a>
                            </twig:Table:RowHeader>
                            <twig:Table:Cell label="Type">{{ shell.abbreviation }}</twig:Table:Cell>
                            <twig:Table:Cell label="Porteur">
                                {% if shell.weightCategory is not null %}
                                    {{ shell.textWeightCategory }}
                                {% else %}
                                    <twig:NoValue />
                                {% endif %}
                            </twig:Table:Cell>
                            <twig:Table:Cell label="Kilométrage">{{ shell.mileage }} km</twig:Table:Cell>
                            <twig:Table:Cell label="Actif">
                                {% if shell.enabled %}
                                    <twig:Badge tone="success">Actif</twig:Badge>
                                {% else %}
                                    <twig:Badge tone="secondary">Inactif</twig:Badge>
                                {% endif %}
                            </twig:Table:Cell>
                            <twig:Table:Cell actions>
                                <twig:Button variant="secondary" outline size="sm" href="{{ path('shell_edit', {'id': shell.id}) }}">
                                    <twig:ux:icon name="mdi:pencil" /> Modifier
                                </twig:Button>
                            </twig:Table:Cell>
                        </twig:Table:Row>
                    {% else %}
                        <twig:Table:Row>
                            <twig:Table:Cell span><twig:EmptyState text="Pas de bateau" /></twig:Table:Cell>
                        </twig:Table:Row>
                    {% endfor %}
                </twig:Table:Body>
            </twig:Table>
        </twig:Card:Body>
    </twig:Card>
{% endblock %}
