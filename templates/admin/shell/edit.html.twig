{% extends 'layouts/app.html.twig' %}

{% block title %}Modifier un bateau{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('admin_home') }}">Administration</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item href="{{ path('shell_index') }}">Gestion du parc</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item href="{{ path('shell_show', {'id': shell.id}) }}">{{ shell.name }}</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>Modifier un bateau</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}Modifier un bateau{% endblock %}

{% block page_actions %}
    <twig:DeleteForm :action="path('shell_delete', {'id': shell.id})" />
{% endblock %}

{% block body %}
    <twig:FormCard>
        {{ include('admin/shell/_form.html.twig') }}
    </twig:FormCard>
{% endblock %}
