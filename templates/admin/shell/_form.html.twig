{{ form_start(form) }}
    {{ form_errors(form) }}

    <div class="row">
        <div class="col-md">
            {{ form_row(form.name) }}
            {{ form_row(form.enabled) }}
            {{ form_row(form.personalBoat) }}
        </div>

        <div class="col-md">
            {{ form_row(form.numberRowers) }}
            {{ form_row(form.rowingType) }}
            {{ form_row(form.coxed) }}
            {{ form_row(form.yolette) }}
        </div>
    </div>

    <twig:Accordion id="shell-quotation" class="mb-3">
        <twig:Accordion:Item id="quotation-fields" title="Informations cotation">
            {{ form_row(form.productionYear) }}
            {{ form_row(form.weightCategory) }}
            {{ form_row(form.newPrice) }}
            {{ form_row(form.mileage) }}

            <div class="row">
                <div class="col-md">
                    {{ form_row(form.riggerMaterial) }}
                </div>
                <div class="col-md">
                    {{ form_row(form.riggerPosition) }}
                </div>
            </div>
        </twig:Accordion:Item>
    </twig:Accordion>

    <twig:Button variant="primary">{{ button_label|default('Enregistrer') }}</twig:Button>
{{ form_end(form) }}
