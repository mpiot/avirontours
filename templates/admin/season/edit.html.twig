{% extends 'layouts/app.html.twig' %}
{% form_theme form 'admin/season/_form_theme.html.twig' %}

{% block title %}Modifier une saison{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('admin_home') }}">Administration</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item href="{{ path('season_index') }}">Gestion des saisons</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item href="{{ path('season_show', { 'id': season.id }) }}">{{ season.name }}</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>Modifier</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}Modifier une saison{% endblock %}

{% block page_actions %}
    <twig:DeleteForm :action="path('season_delete', {'id': season.id})" />
{% endblock %}

{% block body %}
    <twig:FormCard>
        {{ include('admin/season/_form.html.twig') }}
    </twig:FormCard>
{% endblock %}
