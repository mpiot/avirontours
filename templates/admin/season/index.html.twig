{% extends 'layouts/app.html.twig' %}

{% block title %}Gestion des saisons{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('admin_home') }}">Administration</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>Gestion des saisons</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}Gestion des saisons{% endblock %}

{% block page_actions %}
    {% if is_granted('ROLE_SEASON_ADMIN') %}
        <twig:Button variant="primary" outline size="sm" href="{{ path('season_new') }}">
            <twig:ux:icon name="mdi:plus" /> Ajouter une saison
        </twig:Button>
    {% endif %}
{% endblock %}

{% block body %}
    <twig:Card elevated>
        <twig:Card:Body padding="none">
            <twig:Table>
                <twig:Table:Head>
                    <twig:Table:Row>
                        <twig:Table:HeadCell>Nom</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Active</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Inscriptions</twig:Table:HeadCell>
                        {% if is_granted('ROLE_SEASON_ADMIN') %}
                            <twig:Table:HeadCell><span class="visually-hidden">Actions</span></twig:Table:HeadCell>
                        {% endif %}
                    </twig:Table:Row>
                </twig:Table:Head>
                <twig:Table:Body>
                    {% for season in seasons %}
                        <twig:Table:Row>
                            <twig:Table:RowHeader>
                                <a href="{{ path('season_show', { 'id': season.id }) }}" class="stretched-link">{{ season.name }}</a>
                            </twig:Table:RowHeader>
                            <twig:Table:Cell label="Active">
                                {% if season.active %}
                                    <twig:Badge tone="success">Active</twig:Badge>
                                {% else %}
                                    <twig:Badge tone="secondary">Inactive</twig:Badge>
                                {% endif %}
                            </twig:Table:Cell>
                            <twig:Table:Cell label="Inscriptions">
                                {% if season.subscriptionEnabled %}
                                    <twig:Badge tone="success">Ouvertes</twig:Badge>
                                {% else %}
                                    <twig:Badge tone="secondary">Fermées</twig:Badge>
                                {% endif %}
                            </twig:Table:Cell>
                            {% if is_granted('ROLE_SEASON_ADMIN') %}
                                <twig:Table:Cell actions>
                                    <twig:Button variant="secondary" outline size="sm" href="{{ path('season_edit', {'id': season.id}) }}">
                                        <twig:ux:icon name="mdi:pencil" /> Modifier
                                    </twig:Button>
                                </twig:Table:Cell>
                            {% endif %}
                        </twig:Table:Row>
                    {% else %}
                        <twig:Table:Row>
                            <twig:Table:Cell span><twig:EmptyState text="Pas de saison" /></twig:Table:Cell>
                        </twig:Table:Row>
                    {% endfor %}
                </twig:Table:Body>
            </twig:Table>
        </twig:Card:Body>
    </twig:Card>
{% endblock %}
