{% extends 'layouts/app.html.twig' %}

{% block title %}Gestion des profils sportifs{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('admin_home') }}">Administration</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>Gestion des profils sportifs</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}Gestion des profils sportifs{% endblock %}

{% block body %}
    {% set isSearching = app.request.query.get('q') is not empty %}

    <twig:Card elevated>
        <twig:Card:Header>
            <twig:SearchForm
                id="sports-profile-search"
                label="Rechercher un membre"
            />
        </twig:Card:Header>

        <twig:Card:Body padding="none">
            <twig:Table>
                <twig:Table:Head>
                <twig:Table:Row>
                    <twig:Table:HeadCell>Nom</twig:Table:HeadCell>
                    <twig:Table:HeadCell><span class="visually-hidden">Actions</span></twig:Table:HeadCell>
                </twig:Table:Row>
                </twig:Table:Head>
                <twig:Table:Body>
                {% for user in users %}
                    <twig:Table:Row>
                        <twig:Table:Cell label="Nom">
                            {{ user.fullName }}
                        </twig:Table:Cell>
                        <twig:Table:Cell actions>
                            <twig:Button variant="secondary" outline size="sm" href="{{ path('sports_profile_physiology', { 'id': user.id }) }}">
                                <twig:ux:icon name="mdi:heart-pulse" /> Physiologie
                            </twig:Button>

                            <twig:Button variant="secondary" outline size="sm" href="{{ path('sports_profile_physical_qualities', { 'id': user.id }) }}">
                                <twig:ux:icon name="mdi:scale-balance" /> Qualités physiques
                            </twig:Button>

                            <twig:Button variant="secondary" outline size="sm" href="{{ path('sports_profile_workout_maximum_load', { 'id': user.id }) }}">
                                <twig:ux:icon name="mdi:dumbbell" /> 1RM
                            </twig:Button>
                        </twig:Table:Cell>
                    </twig:Table:Row>
                {% else %}
                    <twig:Table:Row>
                        <twig:Table:Cell span>
                            <twig:EmptyState :text="isSearching ? 'Aucun utilisateur ne correspond à cette recherche' : 'Pas d\'utilisateur'" />
                        </twig:Table:Cell>
                    </twig:Table:Row>
                {% endfor %}
                </twig:Table:Body>
            </twig:Table>
        </twig:Card:Body>

        {% if users|length < users.totalItemCount %}
            <twig:Card:Footer>
                <twig:Pagination :pagination="users" />
            </twig:Card:Footer>
        {% endif %}
    </twig:Card>
{% endblock %}
