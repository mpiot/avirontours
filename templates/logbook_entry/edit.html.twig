{% extends 'logbook_entry/base.html.twig' %}

{% block title %}Modifier une sortie{% endblock %}

{% block breadcrumb_items %}
    {{ parent() }}
    <twig:Breadcrumb:Item href="{{ path('logbook_entry_index') }}">Cahier de sorties</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item :current="false">{{ logbook_entry.date|format_date('short')}} - {{ logbook_entry.startAt|format_datetime('none', 'short')}} - {{ logbook_entry.shell.fullName }}</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>Modifier une sortie</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}Modifier une sortie{% endblock %}

{% block page_actions %}
    <twig:DeleteForm :action="path('logbook_entry_delete', {'id': logbook_entry.id})" />
{% endblock %}

{% block body %}
    <twig:FormCard>
        {{ include('logbook_entry/_form.html.twig') }}
    </twig:FormCard>
{% endblock %}
