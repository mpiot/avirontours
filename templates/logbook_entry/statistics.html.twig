{% extends 'logbook_entry/base.html.twig' %}

{% block title %}Statistiques du cahier de sorties{% endblock %}

{% block page_title %}Statistiques{% endblock %}

{% block breadcrumb_items %}
    {{ parent() }}
    <twig:Breadcrumb:Item href="{{ path('logbook_entry_index') }}">Cahier de sorties</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>Statistiques</twig:Breadcrumb:Item>
{% endblock %}

{% block body %}
    {#
     # Three abreast only from xl: the sidebar takes 16 rem from lg, which leaves a podium about
     # 150 px of usable width there — a rank, a full name and a figure on one line do not fit in it.
     # Same reason profile/base.html.twig puts its side column at xl.
     #}
    <twig:CardGrid>
        {{ include('logbook_entry/_top.html.twig', { title: 'Top distances', rows: topDistances, field: 'totalDistance', unit: ' km' }, with_context = false) }}
        {{ include('logbook_entry/_top.html.twig', { title: 'Top sorties', rows: topSessions, field: 'totalSessions', unit: '' }, with_context = false) }}
        {{ include('logbook_entry/_top.html.twig', { title: 'Top bateaux', rows: topShells, field: 'totalSessions', unit: '' }, with_context = false) }}
    </twig:CardGrid>
{% endblock %}
