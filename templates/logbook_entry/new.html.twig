{% extends 'logbook_entry/base.html.twig' %}

{% block title %}Ajouter une sortie{% endblock %}

{% block breadcrumb_items %}
    {{ parent() }}
    <twig:Breadcrumb:Item href="{{ path('logbook_entry_index') }}">Cahier de sorties</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>Ajouter une sortie</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}Ajouter une sortie{% endblock %}

{% block body %}
    <twig:FormCard>
        {{ form_start(form) }}
            {{ form_errors(form) }}

            {{ form_row(form.shell) }}

            {{ form_row(form.crewMembers) }}

            {% if form.nonUserCrewMembers is defined %}
                {{ form_row(form.nonUserCrewMembers) }}
            {% endif %}

            {{ form_row(form.startAt) }}

            <twig:Button variant="primary">Enregistrer</twig:Button>
        {{ form_end(form) }}
    </twig:FormCard>
{% endblock %}
