{% extends 'logbook_entry/base.html.twig' %}

{% block title %}Cahier de sorties{% endblock %}

{% block breadcrumb_items %}
    {{ parent() }}
    <twig:Breadcrumb:Item>Cahier de sorties</twig:Breadcrumb:Item>
{% endblock %}


{% block page_title %}Cahier de sorties{% endblock %}

{% block page_actions %}
    <twig:Button variant="secondary" outline size="sm" href="{{ path('logbook_entry_statistics') }}">
        <twig:ux:icon name="mdi:chart-bar" /> Voir les statistiques
    </twig:Button>

    <twig:Button variant="primary" outline size="sm" href="{{ path('logbook_entry_new') }}">
        <twig:ux:icon name="mdi:plus" /> Ajouter une sortie
    </twig:Button>
{% endblock %}

{% block body %}
    <twig:Card elevated>
        <twig:Card:Body padding="none">
            <twig:Table>
                <twig:Table:Head>
                    <twig:Table:Row>
                        <twig:Table:HeadCell>Bateau</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Équipage</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Date</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Départ</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Retour</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Distance</twig:Table:HeadCell>
                        <twig:Table:HeadCell><span class="visually-hidden">Actions</span></twig:Table:HeadCell>
                    </twig:Table:Row>
                </twig:Table:Head>
                <twig:Table:Body>
                    {% for logbook_entry in logbook_entries %}
                        <twig:Table:Row>
                            <twig:Table:Cell label="Bateau">{{ logbook_entry.shell.fullName }}</twig:Table:Cell>
                            <twig:Table:Cell label="Équipage">
                                {%- set crew = logbook_entry.crewMembers|map(member => { name: member, known: true })
                                    |merge(logbook_entry.nonUserCrewMembers|map(member => { name: member, known: false }))
                                -%}

                                {%- for member in crew -%}
                                    {%- if not loop.first %}{{ loop.last ? ' et ' : ', ' }}{% endif -%}

                                    {%- if member.known -%}
                                        {{ member.name }}
                                    {%- else -%}
                                        <span class="fw-bold">{{ member.name }}<span class="visually-hidden"> (non membre)</span></span>
                                    {%- endif -%}
                                {%- endfor -%}
                            </twig:Table:Cell>
                            <twig:Table:Cell label="Date">{{ logbook_entry.date|format_date('short') }}</twig:Table:Cell>
                            <twig:Table:Cell label="Départ">{{ logbook_entry.startAt|format_datetime('none', 'short') }}</twig:Table:Cell>
                            <twig:Table:Cell label="Retour">
                                {% if logbook_entry.endAt %}
                                    {{ logbook_entry.endAt|format_datetime('none', 'short') }}
                                {% else %}
                                    <twig:NoValue />
                                {% endif %}
                            </twig:Table:Cell>
                            <twig:Table:Cell label="Distance">
                                {%- if logbook_entry.coveredDistance %}
                                    {{ logbook_entry.coveredDistance }} km
                                {% else %}
                                    <twig:NoValue />
                                {% endif -%}
                            </twig:Table:Cell>
                            <twig:Table:Cell actions>
                                {% if logbook_entry.endAt is null %}
                                    <twig:Button variant="primary" size="sm" href="{{ path('logbook_entry_finish', { 'id': logbook_entry.id }) }}">
                                        <twig:ux:icon name="mdi:flag-checkered" /> Finir la sortie
                                    </twig:Button>
                                {% endif %}
                                {% if is_granted('ROLE_LOGBOOK_ADMIN') %}
                                    <twig:Button variant="secondary" outline size="sm" href="{{ path('logbook_entry_edit', {'id': logbook_entry.id}) }}">
                                        <twig:ux:icon name="mdi:pencil" /> Modifier
                                    </twig:Button>
                                {% endif %}
                            </twig:Table:Cell>
                        </twig:Table:Row>
                    {% else %}
                        <twig:Table:Row>
                            <twig:Table:Cell span>
                                <twig:EmptyState text="Pas de sortie" />
                            </twig:Table:Cell>
                        </twig:Table:Row>
                    {% endfor %}
                </twig:Table:Body>
            </twig:Table>
        </twig:Card:Body>

        {% if logbook_entries|length < logbook_entries.totalItemCount %}
            <twig:Card:Footer>
                <twig:Pagination :pagination="logbook_entries" />
            </twig:Card:Footer>
        {% endif %}
    </twig:Card>
{% endblock %}
