{% extends 'logbook_entry/base.html.twig' %}

{% block title %}Finir une sortie{% endblock %}

{% block breadcrumb_items %}
    {{ parent() }}
    <twig:Breadcrumb:Item href="{{ path('logbook_entry_index') }}">Cahier de sorties</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item :current="false">{{ logbook_entry.date|format_date('short')}} - {{ logbook_entry.startAt|format_datetime('none', 'short')}} - {{ logbook_entry.shell.fullName }}</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>Finir une sortie</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}Finir une sortie{% endblock %}

{% block body %}
    <twig:Card elevated>
        <twig:Card:Body>
            {{ form_start(form) }}
                {{ form_errors(form) }}

                {{ form_row(form.endAt) }}

                {{ form_row(form.coveredDistance) }}

                {{ form_row(form.shellDamages) }}

                <twig:Button variant="primary">Terminer la sortie</twig:Button>
            {{ form_end(form) }}
        </twig:Card:Body>
    </twig:Card>
{% endblock %}
