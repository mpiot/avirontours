{% extends 'profile/base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('my_space') }}">Mon espace</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>Mon profil</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}Mon profil{% endblock %}

{% block main %}
    <twig:ListGroup flush class="mb-4">
        <twig:ListGroup:Item label="Nom">{{ app.user.lastName }}</twig:ListGroup:Item>
        <twig:ListGroup:Item label="Prénom">{{ app.user.firstName }}</twig:ListGroup:Item>
        <twig:ListGroup:Item label="Email" :muted="app.user.email is null">
            {% if app.user.email is not null %}
                {{ app.user.email }}
            {% else %}
                <twig:NoValue />
            {% endif %}
        </twig:ListGroup:Item>
        <twig:ListGroup:Item label="Téléphone" :muted="app.user.phoneNumber is null">
            {% if app.user.phoneNumber is not null %}
                {{ app.user.phoneNumber }}
            {% else %}
                <twig:NoValue />
            {% endif %}
        </twig:ListGroup:Item>
    </twig:ListGroup>

    <h2 class="fs-5">Mes licences</h2>

    {% if 1 == renew_season.count %}
        {% for season in renew_season %}
            <h3 class="fs-6 text-body-secondary">Inscriptions pour la saison {{ season.name }}</h3>

            <twig:CardGrid class="mb-4">
                {% for season_category in season.seasonCategories %}
                    <twig:Card>
                        <twig:Card:Body class="d-flex flex-column">
                            <h4 class="fs-6 mb-1">{{ season_category.name }}</h4>

                            <p class="fs-3 mb-2">
                                {{ season_category.price|format_currency('EUR') }}<small class="fs-6 text-body-secondary"> / an</small>
                            </p>

                            {% if season_category.description is not null %}
                                <div class="small text-body-secondary">{{ season_category.description|markdown_to_html }}</div>
                            {% endif %}

                            <twig:Button variant="primary" href="{{ path('renew', { 'slug': season_category.slug }) }}" class="mt-auto">
                                S'inscrire
                            </twig:Button>
                        </twig:Card:Body>
                    </twig:Card>
                {% endfor %}
            </twig:CardGrid>
        {% endfor %}
    {% endif %}

    {% for license in user.licenses %}
        <twig:Card class="mb-3">
            <twig:Card:Header>
                <div>Saison {{ license.seasonCategory.season.name }} ({{ license.seasonCategory.name }})</div>

                <ul class="app-license-states">
                    {% for place in workflow_marked_places(license) %}
                        <li class="app-license-state" data-tone="{{ workflow_metadata(license, 'badge', place) }}">
                            {{- workflow_metadata(license, 'title', place) -}}
                        </li>
                    {% endfor %}
                </ul>
            </twig:Card:Header>

            <twig:Card:Body class="d-flex flex-wrap gap-2">
                <div class="flex-grow-1">
                    {{ (license.medicalCertificate.type.label ~ ' ' ~ license.medicalCertificate.level.label)|capitalize }} du {{ license.medicalCertificate.date|format_date('short') }}<br>
                    Option I.A. Sport&nbsp;: {{ license.optionalInsurance ? 'Oui' : 'Non' }}
                </div>

                {% if not license.payments.empty %}
                    <div>
                        <a href="{{ path('payment_attestation_download', { id: license.id }) }}" download>Attestation de paiement</a>
                    </div>
                {% endif %}
            </twig:Card:Body>
        </twig:Card>
    {% else %}
        <twig:EmptyState text="Pas de licence" />
    {% endfor %}
{% endblock %}
