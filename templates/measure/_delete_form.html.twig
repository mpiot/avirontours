<form method="post" action="{{ path('measure_delete', {'id': measure.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet éléménet ?');">
    <input type="hidden" name="_token" data-controller="csrf-protection" value="{{ csrf_token('submit') }}">

    {% block buttons %}
        <button class="btn btn-outline-danger btn-sm">
            <span class="fas fa-trash-alt"></span> Supprimer
        </button>
    {% endblock %}
</form>
