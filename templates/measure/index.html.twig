{% extends 'base.html.twig' %}

{% block title %}Mes mesures{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item active">Mes mesures</li>
{% endblock %}

{% block body %}
    <div class="d-flex">
        <h1>Mes mesures</h1>

        <div class="ms-auto align-self-center">
            <a
                href="{{ path('measure_new') }}"
                class="btn btn-sm btn-outline-primary"
            >
                <span class="fas fa-plus"></span> Ajouter
            </a>
        </div>
    </div>

    <div class="card border-0 shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Valeur</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for measure in measures %}
                            <tr>
                                <td>{{ measure.measuredAt|format_date('short') }}</td>
                                <td>{{ measure.type.label }}</td>
                                <td>{{ measure.value }} {{ measure.type.unit }}</td>
                                <td>
                                    {% embed 'measure/_delete_form.html.twig' %}
                                        {% block buttons %}
                                            <div class="btn-group-sm">
                                                <a class="btn btn-outline-warning" href="{{ path('measure_edit', {'id': measure.id}) }}">
                                                    <span class="fas fa-pencil-alt"></span> Modifier
                                                </a>

                                                {{ parent() }}
                                            </div>
                                        {% endblock %}
                                    {% endembed %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="text-center">Pas de mesure</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if measures|length < measures.totalItemCount %}
                {{ knp_pagination_render(measures) }}
            {% endif %}
        </div>
    </div>
{% endblock %}
