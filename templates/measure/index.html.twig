{% extends 'layouts/app.html.twig' %}

{% block title %}Mes mesures{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('my_space') }}">Mon espace</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>Mes mesures</twig:Breadcrumb:Item>
{% endblock %}


{% block page_title %}Mes mesures{% endblock %}

{% block page_actions %}
    <twig:Button variant="primary" outline size="sm" href="{{ path('measure_new') }}" data-turbo-frame="modal">
        <twig:ux:icon name="mdi:plus" /> Ajouter
    </twig:Button>
{% endblock %}

{% block body %}
    <twig:Card elevated>
        <twig:Card:Body padding="none">
            <twig:Table>
                <twig:Table:Head>
                    <twig:Table:Row>
                        <twig:Table:HeadCell>Date</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Type</twig:Table:HeadCell>
                        <twig:Table:HeadCell>Valeur</twig:Table:HeadCell>
                        <twig:Table:HeadCell><span class="visually-hidden">Actions</span></twig:Table:HeadCell>
                    </twig:Table:Row>
                </twig:Table:Head>
                <twig:Table:Body>
                    {% for measure in measures %}
                        <twig:Table:Row>
                            <twig:Table:Cell label="Date">{{ measure.measuredAt|format_date('short') }}</twig:Table:Cell>
                            <twig:Table:Cell label="Type">{{ measure.type.label }}</twig:Table:Cell>
                            <twig:Table:Cell label="Valeur">{{ measure.value }} {{ measure.type.unit }}</twig:Table:Cell>
                            <twig:Table:Cell actions>
                                <twig:DeleteForm :action="path('measure_delete', {'id': measure.id})">
                                    <twig:Button variant="secondary" outline href="{{ path('measure_edit', {'id': measure.id}) }}" aria-label="Modifier" data-turbo-frame="modal">
                                        <twig:ux:icon name="mdi:pencil" /> <span class="d-none d-sm-inline">Modifier</span>
                                    </twig:Button>
                                </twig:DeleteForm>
                            </twig:Table:Cell>
                        </twig:Table:Row>
                    {% else %}
                        <twig:Table:Row>
                            <twig:Table:Cell span><twig:EmptyState text="Pas de mesure" /></twig:Table:Cell>
                        </twig:Table:Row>
                    {% endfor %}
                </twig:Table:Body>
            </twig:Table>
        </twig:Card:Body>

        {% if measures|length < measures.totalItemCount %}
            <twig:Card:Footer>
                <twig:Pagination :pagination="measures" />
            </twig:Card:Footer>
        {% endif %}
    </twig:Card>
{% endblock %}
