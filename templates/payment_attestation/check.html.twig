{% extends 'layouts/focus.html.twig' %}

{% block title %}Attestation de paiement{% endblock %}

{% block page_title %}Attestation de paiement{% endblock %}

{% block body %}
    <twig:Card elevated>
        {% if license is not null %}
            {% set legal_guardians = license.user.legalGuardians|map(guardian => guardian.fullName) %}

            {# The same four facts, in the same order, as payment_attestation/pdf.html.twig: whoever
               holds the paper reads the two side by side. #}
            <twig:Card:Header class="d-flex align-items-center gap-2 text-success">
                <twig:ux:icon name="mdi:check-circle" />
                <span class="fw-semibold">Attestation authentique</span>
            </twig:Card:Header>

            <twig:ListGroup flush>
                <twig:ListGroup:Item label="Membre">{{ license.user.fullName }}</twig:ListGroup:Item>

                {% if legal_guardians is not empty %}
                    <twig:ListGroup:Item :label="legal_guardians|length > 1 ? 'Représentants légaux' : 'Représentant légal'">
                        {{- legal_guardians|join(' et ') -}}
                    </twig:ListGroup:Item>
                {% endif %}

                <twig:ListGroup:Item label="Saison">{{ license.seasonCategory.season.extendedName }}</twig:ListGroup:Item>
                <twig:ListGroup:Item label="Date du paiement">{{ license.payedAt|format_date('long') }}</twig:ListGroup:Item>
                <twig:ListGroup:Item label="Montant réglé" emphasis>{{ (license.paymentsAmount / 100)|format_currency('EUR') }}</twig:ListGroup:Item>
            </twig:ListGroup>

            <twig:Card:Footer class="small text-body-secondary">
                Vérification effectuée le {{ 'now'|format_date('long') }} auprès du club Aviron Tours Métropole.
            </twig:Card:Footer>
        {% else %}
            <twig:Card:Header class="d-flex align-items-center gap-2 text-danger">
                <twig:ux:icon name="mdi:close-circle" />
                <span class="fw-semibold">Attestation introuvable</span>
            </twig:Card:Header>

            <twig:Card:Body>
                <p class="mb-0">
                    Aucune attestation ne correspond à ce lien. Vérifiez qu'il a été recopié en entier,
                    ou écrivez-nous à <a href="mailto:contact@avirontours.fr">contact@avirontours.fr</a>.
                </p>
            </twig:Card:Body>
        {% endif %}
    </twig:Card>
{% endblock %}
