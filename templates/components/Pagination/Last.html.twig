{# A direction. Without an `href` there is nothing that way, and the item renders disabled. #}
{% props href = null %}

<twig:Pagination:Item :disabled="href is null">
    <twig:Pagination:Link :href="href">
        <twig:ux:icon name="mdi:chevron-double-right" />
        <span class="visually-hidden">Dernière page</span>
    </twig:Pagination:Link>
</twig:Pagination:Item>
