{#
 # One share of a `Progress:Stacked`. `value` is both how wide the segment is and what it reads as,
 # which is the same number: a segment is its share.
 #
 # `color` is a raw CSS colour rather than a tone, because the hue comes from the data — a sport's
 # colour is picked in `App\Enum\SportType`, not from the theme, and a value computed at runtime
 # cannot become a class.
 #}
{% props value, label, color %}

<div
    {{- attributes.defaults({ class: 'progress', style: "width: #{value}%" }) }}
    role="progressbar"
    aria-label="{{ label }}"
    aria-valuenow="{{ value }}"
    aria-valuemin="0"
    aria-valuemax="100"
>
    <div class="progress-bar" style="background: {{ color }}"></div>
</div>
