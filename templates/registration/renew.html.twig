{% extends 'base.html.twig' %}
{% set appMenuAutoOpen = false %}

{% block title %}Ma réinscription{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item"><a href="{{ path('profile_show') }}">Mon profil</a></li>
    <li class="breadcrumb-item active">Ma réinscription</li>
{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-7">
            <h1>Ma réinscription</h1>

            <div class="card border-0 shadow">
                <div class="card-header">
                    {{ include('registration/_season_category_recap.html.twig') }}
                </div>
                <div class="card-body">
                    {{ include('registration/_intro.html.twig', { renew: true }) }}
                    {{ include('registration/_form.html.twig', { renew: true }) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
