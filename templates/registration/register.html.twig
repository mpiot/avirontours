{% extends 'layouts/focus.html.twig' %}

{% block title %}M'inscrire à l'Aviron Tours Métropole{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" defer></script>
{% endblock %}

{% block page_title %}M'inscrire à l'Aviron Tours Métropole{% endblock %}

{% block body %}
    <p>
        Déjà membre&nbsp;? Vous gérez vos réinscriptions depuis
        <a href="{{ path('profile_show') }}">votre profil utilisateur</a>.
    </p>

    <twig:Card elevated>
        <twig:Card:Header>
            {{ include('registration/_season_category_recap.html.twig') }}
        </twig:Card:Header>
        <twig:Card:Body>
            {{ include('registration/_intro.html.twig', { renew: false }) }}
            {{ include('registration/_form.html.twig', { renew: false }) }}
        </twig:Card:Body>
    </twig:Card>
{% endblock %}
