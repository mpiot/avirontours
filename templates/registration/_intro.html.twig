{% import 'registration/_macros.html.twig' as registration %}

{% set minors_link = registration.pdf_link('qs-sport-mineurs.pdf', 'QS-Sport mineurs') %}
{% set adults_link = registration.pdf_link('qs-sport-majeurs.pdf', 'QS-Sport majeurs') %}
{% set certificate_link = registration.pdf_link('certificat-medical.pdf', 'Certificat médical') %}

<twig:Alert tone="neutral" :live="false" id="registration-intro" class="mb-4">
    <p class="mb-2">
        Avant de commencer, munissez-vous de votre
        <span class="fw-bold">certificat médical ou attestation QS-Sport</span>. Il doit être
        <span class="fw-bold">définitif</span>&nbsp;: nous ne le remplaçons pas après
        {{ renew ? 'réinscription' : 'inscription' }}.
    </p>

    <p class="form-text mb-0">
        Formulaires vierges&nbsp;:
        {{ minors_link }}

        {% if renew %}
            &middot; {{ adults_link }}
        {% endif %}

        &middot; {{ certificate_link }}
    </p>
</twig:Alert>
