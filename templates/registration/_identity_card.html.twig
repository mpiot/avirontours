{% set birthday_label = "#{member.birthday|format_date('short')} (#{member.age} ans)" %}

<twig:Card tone="muted" class="mb-3">
    <twig:Card:Body>
        <p class="form-text mt-0">
            <twig:ux:icon name="mdi:lock" class="me-1" />
            Ces informations ne sont modifiables que par le club.
        </p>

        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <twig:LockedField id="locked-gender" label="Genre" :value="member.textGender" />
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <twig:LockedField id="locked-first-name" label="Prénom" :value="member.firstName" />
            </div>
            <div class="col-md-6">
                <twig:LockedField id="locked-last-name" label="Nom" :value="member.lastName" />
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md">
                <twig:LockedField id="locked-birthday" label="Date de naissance" :value="birthday_label" />
            </div>
            <div class="col-md">
                <twig:LockedField
                    id="locked-nationality"
                    label="Nationalité"
                    :value="member.nationality ? member.nationality|country_name : '-'"
                />
            </div>
        </div>
    </twig:Card:Body>
</twig:Card>
