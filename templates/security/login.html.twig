{% extends 'layouts/auth.html.twig' %}

{% block title %}Se connecter{% endblock %}

{% block heading %}Connexion{% endblock %}

{% block subtitle %}Accédez à votre espace membre.{% endblock %}

{% block body %}
    {% if error %}
        <twig:Alert tone="danger" icon>
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </twig:Alert>
    {% endif %}

    <form method="post">
        <div class="mb-3">
            <twig:Label for="username">Utilisateur</twig:Label>
            <twig:Input
                size="lg"
                id="username"
                name="_username"
                autocomplete="username"
                aria-describedby="username_help"
                :value="last_username ?? ''"
                required
                autofocus
            />
            <p id="username_help" class="form-text mb-0">Nom utilisateur&nbsp;: prenom.nom</p>
        </div>

        <div class="mb-3">
            <twig:Label for="password">Mot de passe</twig:Label>
            <twig:Input type="password" size="lg" id="password" name="_password" autocomplete="current-password" required />
        </div>

        <twig:Checkbox id="remember_me" label="Se souvenir de moi" name="_remember_me" class="mb-4" />

        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

        <div class="d-grid mt-4">
            <twig:Button variant="primary" size="lg" data-turbo-submits-with="Connexion en cours&hellip;">Se connecter</twig:Button>
        </div>
    </form>

    <p class="mt-3 mb-0 text-center">
        <a href="{{ path('app_forgot_password_request') }}">Mot de passe oublié&nbsp;?</a>
    </p>
{% endblock %}
