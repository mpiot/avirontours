{% extends 'layouts/auth.html.twig' %}

{% block title %}Réinitialiser votre mot de passe{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" defer></script>
{% endblock %}

{% block heading %}Mot de passe oublié{% endblock %}

{% block subtitle %}Indiquez votre identifiant&nbsp;: nous enverrons un lien de réinitialisation à l'adresse email enregistrée au club.{% endblock %}

{% block body %}
    {{ form_start(requestForm) }}
        {{ form_errors(requestForm) }}

        {{ form_row(requestForm.username, {
            'help': 'Nom utilisateur&nbsp;: prenom.nom',
            'help_html': true,
            'attr': { 'class': 'form-control-lg', 'autofocus': true }
        }) }}

        <div class="d-flex justify-content-center mb-3">
            {{ form_row(requestForm.turnstile) }}
        </div>

        <div class="d-grid">
            <twig:Button variant="primary" size="lg" data-turbo-submits-with="Envoi en cours&hellip;">Envoyer un email de récupération</twig:Button>
        </div>
    {{ form_end(requestForm) }}

    <p class="mt-3 mb-0 text-center">
        <a href="{{ path('app_login') }}">Retour à la connexion</a>
    </p>
{% endblock %}
