{% extends 'layouts/auth.html.twig' %}

{% block title %}Réinitialiser votre mot de passe{% endblock %}

{% block heading %}Nouveau mot de passe{% endblock %}

{% block subtitle %}Choisissez un mot de passe que vous n'utilisez pas ailleurs.{% endblock %}

{% block body %}
    {{ form_start(resetForm) }}
        {{ form_errors(resetForm) }}

        {{ form_row(resetForm.plainPassword.first, {
            'attr': { 'class': 'form-control-lg', 'autofocus': true }
        }) }}

        {{ form_row(resetForm.plainPassword.second, {
            'attr': { 'class': 'form-control-lg' }
        }) }}

        <div class="d-grid mt-4">
            <twig:Button variant="primary" size="lg" data-turbo-submits-with="Enregistrement&hellip;">Réinitialiser le mot de passe</twig:Button>
        </div>
    {{ form_end(resetForm) }}
{% endblock %}
