{% extends 'layouts/app.html.twig' %}

{% set sessionName = "#{training.sport.label} · #{training.trainedAt|format_date('short')}" %}

{% block title %}{{ sessionName }}{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('my_space') }}">Mon espace</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item href="{{ path('training_index', {'endAt': training.trainedAt|date_modify('monday this week')|date('Y-m-d')}) }}#training-{{ training.id }}">Mes entraînements</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>{{ sessionName }}</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}{{ training.sport.label }} <small class="fs-6 text-body-secondary">{{ training.trainedAt|format_date('short') }}</small>{% endblock %}

{% block page_actions %}
    <twig:DeleteForm :action="path('training_delete', {'id': training.id})">
        <twig:Button variant="secondary" outline href="{{ path('training_edit', {'id': training.id}) }}" aria-label="Modifier">
            <twig:ux:icon name="mdi:pencil" /> <span class="d-none d-sm-inline">Modifier</span>
        </twig:Button>
    </twig:DeleteForm>
{% endblock %}

{% block body %}
    {{ include('training/_show.html.twig') }}
{% endblock %}
