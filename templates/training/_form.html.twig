{{ form_start(form) }}
    {{ form_errors(form) }}

    {{ form_row(form.sport) }}
    {{ form_row(form.trainedAt) }}

    <div class="row">
        <div class="col-sm">
            {{ form_row(form.duration) }}
        </div>

        <div class="col-sm">
            <div class="mb-3">
                {{ form_label(form.distance) }}

                <twig:InputGroup :invalid="form.distance.vars.errors|length > 0">
                    {{ form_widget(form.distance, { attr: { inputmode: 'decimal' } }) }}
                    <twig:InputGroup:Text>km</twig:InputGroup:Text>
                    {{ form_errors(form.distance) }}
                </twig:InputGroup>
            </div>
        </div>
    </div>

    {{ form_row(form.feeling) }}
    {{ form_row(form.ratedPerceivedExertion) }}

    {{ form_row(form.comment) }}

    {{ form_rest(form) }}

    <twig:Button variant="primary">{{ button_label|default('Enregistrer') }}</twig:Button>
{{ form_end(form) }}
