{{ form_start(form, { attr: { 'data-controller': 'dependent-field' } }) }}
    {{ form_errors(form) }}

    {{ form_row(form.sport, { attr: { 'data-action': 'change->dependent-field#change' } }) }}
    {{ form_row(form.trainedAt) }}

    <div class="row">
        <div class="col-sm">
            {{ form_row(form.duration) }}
        </div>

        <div class="col-sm" id="training_distance_container" {{ stimulus_target('dependent-field', 'target') }}>
            {% if form.distance is defined %}
                <div class="mb-3">
                    {{ form_label(form.distance) }}

                    <twig:InputGroup :invalid="form.distance.vars.errors|length > 0">
                        {{ form_widget(form.distance) }}
                        <twig:InputGroup:Text>{{ form.distance.vars.unit.value }}</twig:InputGroup:Text>
                        {{ form_errors(form.distance) }}
                    </twig:InputGroup>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="row">
        <div class="col-sm">
            <div class="mb-3">
                {{ form_label(form.averageHeartRate) }}

                <twig:InputGroup :invalid="form.averageHeartRate.vars.errors|length > 0">
                    {{ form_widget(form.averageHeartRate) }}
                    <twig:InputGroup:Text>bpm</twig:InputGroup:Text>
                    {{ form_errors(form.averageHeartRate) }}
                </twig:InputGroup>
            </div>
        </div>

        <div class="col-sm">
            <div class="mb-3">
                {{ form_label(form.maxHeartRate) }}

                <twig:InputGroup :invalid="form.maxHeartRate.vars.errors|length > 0">
                    {{ form_widget(form.maxHeartRate) }}
                    <twig:InputGroup:Text>bpm</twig:InputGroup:Text>
                    {{ form_errors(form.maxHeartRate) }}
                </twig:InputGroup>
            </div>
        </div>
    </div>

    {{ form_row(form.feeling) }}
    {{ form_row(form.ratedPerceivedExertion) }}

    {{ form_row(form.comment, { attr: { rows: 5 } }) }}

    {{ form_rest(form) }}

    <twig:Button variant="primary">{{ button_label|default('Enregistrer') }}</twig:Button>
{{ form_end(form) }}
