{% extends 'base.html.twig' %}

{% block title %}Mes entraînements{% endblock %}

{% block breadcrumb %}
    {{ parent() }}
    <li class="breadcrumb-item active">Mes entraînements</li>
{% endblock %}

{% block body %}
    <div class="d-flex">
        <h1>Mes entraînements</h1>

        <div class="ms-auto align-self-center">
            <div class="btn-group" role="group">
                <a
                    href="{{ path('training_new') }}"
                    class="btn btn-outline-primary"
                >
                    <span class="fas fa-plus"></span> Ajouter
                </a>

                <div class="btn-group" role="group">
                    <button
                        type="button"
                        class="btn btn-outline-primary dropdown-toggle"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                    ></button>

                    <ul class="dropdown-menu">
                        <li>
                            <a
                                href="{{ path('training_import_concept_logbook') }}"
                                class="dropdown-item {%- if app.user.concept2RefreshToken is null %} disabled{% endif %}"
                            >
                                <span class="fa fa-sync"></span> Sync ErgData
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow mt-3">
        <div class="card-body">
            <div class="d-flex justify-content-center align-items-center mb-3">
                <a
                    href="{{ path('training_index', { 'endAt': endAt.modify('-1 week')|date('Y-m-d') }) }}"
                    class="btn btn-sm btn-outline-secondary"
                >
                    <<
                </a>

                <span class="mx-5 text-center">
                    Du {{ startAt|format_date('short') }} au {{ endAt|format_date('short') }}
                </span>

                <a
                    href="{{ path('training_index', { 'endAt': endAt.modify('+1 day')|date('Y-m-d') }) }}"
                    class="btn btn-sm btn-outline-secondary"
                >
                    >>
                </a>
            </div>

            <div id="training-list" class="d-flex flex-column-reverse">
                {% for weekData in data %}
                    <div class="mb-3">
                       <span class="fs-5">
                             Semaine {{ weekData.week|date('W - Y') }}
                       </span>

                        <div class="row g-0 border border-primary-subtle rounded mb-1 position-relative" style="border-style: dashed !important;">
                            <div class="col p-3 small">
                                <div class="d-flex align-items-center text-secondary">
                                    <div class="d-flex align-items-center">
                                        <twig:ux:icon name="bi:speedometer" />
                                        <span class="ms-1">{{ weekData.summary.sessions }} sessions</span>
                                    </div>

                                    <div class="d-flex align-items-center ms-3">
                                        <twig:ux:icon name="mdi:stopwatch-outline" />
                                        <span class="ms-1">{{ weekData.summary.duration|format_seconds }}</span>
                                    </div>
                                </div>

                                {% if weekData.summary.sports is not empty %}
                                    <div class="text-secondary mt-3">
                                        {% for sportSummary in weekData.summary.sports %}
                                            <div class="mt-1">
                                                {{ sportSummary.sport.label }}

                                                <div class="d-flex ms-3">
                                                    <div class="d-flex align-items-center">
                                                        <twig:ux:icon name="bi:speedometer" />
                                                        <span class="ms-1">{{ sportSummary.sessions }} sessions</span>
                                                    </div>

                                                    <div class="d-flex align-items-center ms-3">
                                                        <twig:ux:icon name="mdi:stopwatch-outline" />
                                                        <span class="ms-1">{{ sportSummary.duration|format_seconds }}</span>
                                                    </div>

                                                    {% if sportSummary.distance is not same as(0) %}
                                                        <div class="d-flex align-items-center ms-3">
                                                            <twig:ux:icon name="mdi:arrow-left-right" />
                                                            <span class="ms-1">{{ (sportSummary.distance / 1000)|format_number({fraction_digit: 0}) }} km</span>
                                                        </div>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>

                                    <div class="progress-stacked mt-3">
                                        {% for sportSummary in weekData.summary.sports %}
                                            <div class="progress" role="progressbar" aria-label="Segment one" aria-valuenow="{{ sportSummary.ratio * 100 }}" aria-valuemin="0" aria-valuemax="100" style="width: {{ sportSummary.ratio * 100 }}%">
                                                <div class="progress-bar" style="background: {{ sportSummary.sport.color }}"></div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        {% for training in weekData.trainings %}
                            <div
                                id="training-{{ training.id }}"
                                class="row g-0 border border-secondary-subtle rounded mb-1 position-relative"
                            >
                                <div class="col-2 col-md-1 text-white d-flex justify-content-center align-items-center" style="background: {{ training.sport.color }}">
                                    <twig:ux:icon name="{{ training.sport.icon }}" width="32" height="32" />
                                </div>

                                <div class="col p-2 small">
                                    <div class="d-flex align-items-center">
                                        <a
                                            href="{{ path('training_show', { id: training.id }) }}"
                                            class="link-dark text-decoration-none stretched-link"
                                        >
                                            {{ training.sport.label }}
                                        </a>

                                        <span class="ms-auto text-secondary">
                                            {{ training.trainedAt|format_datetime(pattern: 'cccc dd MMM')|capitalize }}
                                        </span>
                                    </div>

                                    <div class="d-flex align-items-center text-secondary">
                                        <div class="d-flex align-items-center">
                                            <twig:ux:icon name="mdi:stopwatch-outline" />
                                            <span class="ms-1">{{ training.formattedDuration }}</span>
                                        </div>

                                        <div class="d-flex align-items-center ms-3">
                                            <twig:ux:icon name="mdi:arrow-left-right" />
                                            <span class="ms-1">
                                                {% if training.distance is not null %}
                                                    {{ (training.distance / 1000)|round }} km
                                                {% else %}
                                                    -
                                                {% endif %}
                                            </span>
                                        </div>

                                        <div class="d-flex align-items-center ms-3">
                                            <twig:ux:icon name="mdi:speedometer" />
                                            <span class="ms-1">
                                                {% if training.formattedPace is not null %}
                                                    {{ training.formattedPace }}/500m
                                                {% else %}
                                                    -
                                                {% endif %}
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}
