{% set phases = training.trainingPhases %}
{% set activePhaseIndex = phases.indexOf(active_phase) %}
{% set activePhaseNumber = activePhaseIndex + 1 %}

<turbo-frame id="training-phases">
    {% if phases|length > 1 %}
        {% set previousPhase = activePhaseIndex > 0 ? phases.get(activePhaseIndex - 1) : null %}
        {% set nextPhase = phases.get(activePhaseIndex + 1) %}

        <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
            <twig:Button
                variant="secondary"
                outline
                size="sm"
                :href="previousPhase ? path('training_show_phase', { training_id: training.id, id: previousPhase.id }) : null"
                aria-label="Phase précédente"
                :disabled="previousPhase is null"
            >
                <twig:ux:icon name="mdi:chevron-left" />
            </twig:Button>

            <h3 class="app-chart-phase-title mb-0">Phase {{ activePhaseNumber }}</h3>

            <twig:Button
                variant="secondary"
                outline
                size="sm"
                :href="nextPhase ? path('training_show_phase', { training_id: training.id, id: nextPhase.id }) : null"
                aria-label="Phase suivante"
                :disabled="nextPhase is null"
            >
                <twig:ux:icon name="mdi:chevron-right" />
            </twig:Button>
        </div>
    {% endif %}

    {% if charts is empty %}
        <twig:EmptyState text="Pas de données" />
    {% else %}
        <div class="app-charts">
            {% for chart in charts %}
                <div class="app-chart">
                    <p class="app-chart-title">{{ chart.title }}</p>

                    {{ render_chart(chart.chart, {
                        'data-controller': 'ergometer-chart',
                        'data-ergometer-chart-unit-value': chart.unit,
                        'role': 'img',
                        'aria-label': "#{chart.title} au fil de la phase #{activePhaseNumber}",
                    }) }}
                </div>
            {% endfor %}
        </div>
    {% endif %}
</turbo-frame>
