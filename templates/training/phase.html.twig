{% set activePhaseNumber = training.trainingPhases.indexOf(active_phase) + 1 %}

<turbo-frame id="training-phases">
    {% if training.trainingPhases|length > 1 %}
        <h3 class="app-chart-phase-title">Phase {{ activePhaseNumber }}</h3>
    {% endif %}

    {% if charts is empty %}
        <twig:EmptyState text="Pas de données" />
    {% else %}
        <div class="app-charts">
            {% for chart in charts %}
                <div class="app-chart">
                    <p class="app-chart-title">{{ chart.title }}</p>

                    {{ render_chart(chart.chart, {
                        'data-controller': 'ergometer-chart',
                        'data-ergometer-chart-unit-value': chart.unit,
                        'role': 'img',
                        'aria-label': "#{chart.title} au fil de la phase #{activePhaseNumber}",
                    }) }}
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {% if training.trainingPhases|length > 1 %}
        {% set withIntensities = training.trainingPhases|filter(phase => phase.intensity is not null)|length > 0 %}

        <twig:Table class="mt-3">
            <twig:Table:Head>
                <twig:Table:Row>
                    <twig:Table:HeadCell>Phase</twig:Table:HeadCell>
                    {% if withIntensities %}
                        <twig:Table:HeadCell>Type</twig:Table:HeadCell>
                    {% endif %}
                    <twig:Table:HeadCell>Durée</twig:Table:HeadCell>
                    <twig:Table:HeadCell>Distance</twig:Table:HeadCell>
                    <twig:Table:HeadCell>{{ training.sport.speedLabel }}</twig:Table:HeadCell>
                    <twig:Table:HeadCell>Puissance</twig:Table:HeadCell>
                    <twig:Table:HeadCell>
                        <twig:ux:icon name="mdi:heart" />
                        <span class="visually-hidden">Fréquence cardiaque</span>
                    </twig:Table:HeadCell>
                    <twig:Table:HeadCell>Cadence</twig:Table:HeadCell>
                    <twig:Table:HeadCell><span class="visually-hidden">Actions</span></twig:Table:HeadCell>
                </twig:Table:Row>
            </twig:Table:Head>

            <twig:Table:Body>
                {% for trainingPhase in training.trainingPhases %}
                    {% set phaseNumber = loop.index %}

                    <twig:Table:Row :active="active_phase == trainingPhase">
                        <twig:Table:Cell label="Phase">{{ phaseNumber }}</twig:Table:Cell>
                        {% if withIntensities %}
                            <twig:Table:Cell label="Type">
                                {% if trainingPhase.intensity is not null %}
                                    {{ trainingPhase.intensity.label }}
                                {% else %}
                                    <twig:NoValue />
                                {% endif %}
                            </twig:Table:Cell>
                        {% endif %}
                        <twig:Table:Cell label="Durée">{{ trainingPhase.formattedDuration }}</twig:Table:Cell>
                        <twig:Table:Cell label="Distance">{{ trainingPhase.distance }} m</twig:Table:Cell>
                        <twig:Table:Cell :label="training.sport.speedLabel">
                            {% set speed = trainingPhase.isRest ? null : training.sport.formatSpeed(trainingPhase.duration, trainingPhase.distance) %}
                            {% if speed is not null %}
                                {{ speed }} {{ training.sport.speedUnit }}
                            {% else %}
                                <twig:NoValue />
                            {% endif %}
                        </twig:Table:Cell>
                        <twig:Table:Cell label="Puissance">
                            {% if not trainingPhase.isRest and trainingPhase.averageWatt is not null %}
                                {{ trainingPhase.averageWatt }} W
                            {% else %}
                                <twig:NoValue />
                            {% endif %}
                        </twig:Table:Cell>
                        <twig:Table:Cell label="Fréquence cardiaque">
                            {% if trainingPhase.endingHeartRate is not null %}
                                {{ trainingPhase.endingHeartRate }}
                            {% else %}
                                <twig:NoValue />
                            {% endif %}
                        </twig:Table:Cell>
                        <twig:Table:Cell label="Cadence">
                            {% if trainingPhase.strokeRate is not null %}
                                {{ trainingPhase.strokeRate }}
                            {% else %}
                                <twig:NoValue />
                            {% endif %}
                        </twig:Table:Cell>
                        <twig:Table:Cell actions>
                            <a
                                href="{{ path('training_show_phase', { training_id: training.id, id: trainingPhase.id }) }}"
                                class="link-body-emphasis"
                                aria-label="Voir la phase {{ phaseNumber }}"
                                {%- if active_phase == trainingPhase %} aria-current="true"{% endif %}
                            >
                                <twig:ux:icon name="mdi:chart-line" />
                            </a>
                        </twig:Table:Cell>
                    </twig:Table:Row>
                {% endfor %}
            </twig:Table:Body>
        </twig:Table>
    {% endif %}
</turbo-frame>
