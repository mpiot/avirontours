{% extends 'layouts/app.html.twig' %}

{% block body %}
    <div class="row">
        <div class="col-12 col-xl-3">
            <twig:Card elevated class="mb-3">
                <twig:Card:Body>
                    <nav class="app-subnav" aria-label="Navigation du profil sportif">
                        {{ include('sport_profile/_nav_items.html.twig') }}
                    </nav>
                </twig:Card:Body>
            </twig:Card>
        </div>

        <div class="col-12 col-xl-9">
            <twig:Card elevated>
                {# Not `Card:Body`: `outerBlocks` reaches the page one component deep, not two. #}
                <div class="card-body">
                    {{ block(outerBlocks.main) }}
                </div>
            </twig:Card>
        </div>
    </div>
{% endblock %}
