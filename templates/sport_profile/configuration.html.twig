{% extends 'sport_profile/base.html.twig' %}

{% block title %}Configuration{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('my_space') }}">Mon espace</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item :current="false">Mon profil sportif</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>Configuration</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}Configuration{% endblock %}

{% block main %}
    <h2 class="fs-5">Paramètres liés aux entraînements</h2>
    {{ form_start(form) }}
        {{ form_widget(form) }}

        <twig:Button variant="primary" class="mt-2">Enregistrer</twig:Button>
    {{ form_end(form) }}

    <h2 class="fs-5 mt-5">Services connectés</h2>
    <div class="row">
        <div class="col-8">
            <h3 class="fs-6">Compte Concept2</h3>
            <p>
                Lier mon compte Log Concept2 (<a href="https://log.concept2.com/">https://log.concept2.com/</a>) pour
                importer automatiquement mes séances d'ergomètre via l'application ErgData.<br>
                {% if app.user.concept2RefreshToken is null %}
                    <span class="text-body-secondary">Aucun compte connecté</span>
                {% else %}
                    <span class="text-success">Compte connecté</span>
                {% endif %}
            </p>
        </div>
        <div class="col-4 text-center">
            {% if app.user.concept2RefreshToken is null %}
                <twig:Button variant="primary" size="sm" href="{{ path('oauth_concept2_connect') }}">
                    Se connecter
                </twig:Button>
            {% else %}
                <twig:Button variant="secondary" outline size="sm" href="{{ path('oauth_concept2_unconnect') }}">
                    Se déconnecter
                </twig:Button>
            {% endif %}
        </div>
    </div>
{% endblock %}
