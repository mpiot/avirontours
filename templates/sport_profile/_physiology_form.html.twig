{# The five zones climb from B0 to B5, then come the markers that bound them — keep that order. #}
{% macro bounded_field(field, unit, inputmode = 'numeric') %}
    <div class="mb-3">
        {{ form_label(field) }}

        <twig:InputGroup :invalid="field.vars.errors|length > 0">
            {{ form_widget(field, { attr: { inputmode: inputmode } }) }}
            <twig:InputGroup:Text>{{ unit }}</twig:InputGroup:Text>
            {{ form_errors(field) }}
        </twig:InputGroup>

        {{ form_help(field) }}
    </div>
{% endmacro %}

{{ form_start(form) }}
    {{ form_errors(form) }}

    <fieldset class="mb-4">
        <legend class="fs-5"><twig:ux:icon name="mdi:heart" class="me-2" />Zones d'entraînement</legend>

        <div class="row">
            <div class="col-sm-6">{{ _self.bounded_field(form.lightAerobicHeartRateMin, 'bpm') }}</div>
            <div class="col-sm-6">{{ _self.bounded_field(form.heavyAerobicHeartRateMin, 'bpm') }}</div>
            <div class="col-sm-6">{{ _self.bounded_field(form.anaerobicThresholdHeartRateMin, 'bpm') }}</div>
            <div class="col-sm-6">{{ _self.bounded_field(form.oxygenTransportationHeartRateMin, 'bpm') }}</div>
            <div class="col-sm-6">{{ _self.bounded_field(form.anaerobicHeartRateMin, 'bpm') }}</div>
        </div>
    </fieldset>

    <fieldset class="mb-4">
        <legend class="fs-5"><twig:ux:icon name="mdi:heart-pulse" class="me-2" />Repères</legend>

        <div class="row">
            <div class="col-sm-6">{{ _self.bounded_field(form.restingHeartRate, 'bpm') }}</div>
            <div class="col-sm-6">{{ _self.bounded_field(form.maximumHeartRate, 'bpm') }}</div>
            <div class="col-sm-6">{{ _self.bounded_field(form.maximumOxygenConsumption, 'ml/kg/min', 'decimal') }}</div>
        </div>
    </fieldset>

    {{ form_rest(form) }}

    <twig:Button variant="primary">Enregistrer</twig:Button>
{{ form_end(form) }}
