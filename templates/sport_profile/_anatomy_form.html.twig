{{ form_start(form) }}
    {{ form_errors(form) }}

    <div class="row">
        <div class="col-sm-6">
            {{ form_row(form.height) }}
            {{ form_row(form.weight) }}
        </div>

        <div class="col-sm-6">
            {{ form_row(form.armSpan) }}
            {{ form_row(form.bustLength) }}
            {{ form_row(form.legLength) }}
        </div>
    </div>

    <twig:Button variant="primary" class="mt-3">Enregistrer</twig:Button>
{{ form_end(form) }}
