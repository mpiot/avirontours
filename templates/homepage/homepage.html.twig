{% extends 'layouts/app.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('my_space') }}">Mon espace</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>Tableau de bord</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}Tableau de bord{% endblock %}

{% block body %}
    {% set has_anything = kpis.hasRecentTrainings
        or trainingLoadChart is not null
        or trainingVolumeChart is not null
        or app.user.physiology is not null
    %}

    <div class="row g-3">
        {% if kpis.hasRecentTrainings %}
            <div class="col-12">
                <twig:Card elevated>
                    <twig:Card:Body>
                        <h2 class="fs-5">7 derniers jours</h2>

                        <twig:Stats>
                            <twig:Stats:Item label="Séances">{{ kpis.volumes.sessions }}</twig:Stats:Item>

                            <twig:Stats:Item label="Durée">
                                {{- kpis.volumes.duration|format_seconds_as_hours_minutes -}}
                            </twig:Stats:Item>

                            {% if kpis.volumes.distance > 0 %}
                                <twig:Stats:Item label="Distance" unit="km">
                                    {{- (kpis.volumes.distance / 1000)|format_number({fraction_digit: 1}) -}}
                                </twig:Stats:Item>
                            {% endif %}
                        </twig:Stats>
                    </twig:Card:Body>
                </twig:Card>
            </div>
        {% endif %}

        {% if trainingLoadChart is not null or kpis.hasRecentTrainings %}
            <div class="col-12 col-xl-6">
                <twig:Card elevated class="h-100">
                    <twig:Card:Body>
                        <h2 class="fs-5">Charge d'entraînement</h2>

                        {% if trainingLoadChart is not null %}
                            <twig:Stats class="mb-3">
                                <twig:Stats:Item label="7 derniers jours">
                                    {%- if kpis.load.acute is not null -%}
                                        {{ kpis.load.acute }}
                                    {%- else -%}
                                        <twig:NoValue label="aucune séance notée" />
                                    {%- endif -%}
                                </twig:Stats:Item>

                                <twig:Stats:Item label="Condition">
                                    {%- if kpis.load.fitness is not null -%}
                                        {{ kpis.load.fitness|round }}
                                    {%- else -%}
                                        <twig:NoValue label="non calculée" />
                                    {%- endif -%}
                                </twig:Stats:Item>

                                <twig:Stats:Item label="Fatigue">
                                    {%- if kpis.load.fatigue is not null -%}
                                        {{ kpis.load.fatigue|round }}
                                    {%- else -%}
                                        <twig:NoValue label="non calculée" />
                                    {%- endif -%}
                                </twig:Stats:Item>

                                <twig:Stats:Item label="Fraîcheur">
                                    {%- if kpis.load.form is not null -%}
                                        {{ kpis.load.form > 0 ? '+' }}{{ kpis.load.form|round }}
                                    {%- else -%}
                                        <twig:NoValue label="non calculée" />
                                    {%- endif -%}
                                </twig:Stats:Item>
                            </twig:Stats>

                            {% if kpis.load.acute is null %}
                                <p class="small text-body-secondary">
                                    Notez l'effort de vos séances pour calculer les valeurs manquantes.
                                </p>
                            {% elseif kpis.load.rated < kpis.volumes.sessions %}
                                <p class="small text-body-secondary">
                                    {{ kpis.load.rated }} {{ 'séance notée|séances notées'|trans({'%count%': kpis.load.rated}) }}
                                    sur {{ kpis.volumes.sessions }}&nbsp;: la charge ne compte que celles-là.
                                </p>
                            {% endif %}

                            <div class="app-chart">
                                {{ render_chart(trainingLoadChart, { 'role': 'img', 'aria-label': "Charge hebdomadaire d'entraînement" }) }}
                            </div>
                        {% else %}
                            <twig:EmptyState text="Notez l'effort de vos séances pour suivre votre charge d'entraînement." />

                            <div class="text-center mt-2">
                                <twig:Button variant="primary" outline size="sm" href="{{ path('training_index') }}">
                                    Noter mes séances
                                </twig:Button>
                            </div>
                        {% endif %}
                    </twig:Card:Body>
                </twig:Card>
            </div>
        {% endif %}

        {% if trainingVolumeChart is not null %}
            <div class="col-12 col-xl-6">
                <twig:Card elevated class="h-100">
                    <twig:Card:Body>
                        <h2 class="fs-5">Volume d'entraînement</h2>
                        <div class="app-chart">
                            {{ render_chart(trainingVolumeChart, { 'role': 'img', 'aria-label': "Volume mensuel d'entraînement par spécificité" }) }}
                        </div>
                    </twig:Card:Body>
                </twig:Card>
            </div>
        {% endif %}

        {% if app.user.physiology is not null %}
            <div class="col-12 col-xl-6">
                <twig:Card elevated class="h-100">
                    <twig:Card:Body class="flex-grow-0">
                        <h2 class="fs-5">Ma physiologie</h2>
                    </twig:Card:Body>

                    {% set zones = [
                        { label: 'B0 - UT2', value: app.user.physiology.lightAerobicHeartRateRange, unit: 'bpm' },
                        { label: 'B1 - UT1', value: app.user.physiology.heavyAerobicHeartRateRange, unit: 'bpm' },
                        { label: 'B2 - AT', value: app.user.physiology.anaerobicThresholdHeartRateRange, unit: 'bpm' },
                        { label: 'B3 - TR', value: app.user.physiology.oxygenTransportationHeartRateRange, unit: 'bpm' },
                        { label: 'B5 - AN', value: app.user.physiology.anaerobicHeartRateRange, unit: 'bpm' },
                        { label: 'VO2max', value: app.user.physiology.maximumOxygenConsumption, unit: 'ml/min/kg' },
                    ] %}

                    <twig:ListGroup flush>
                        {% for zone in zones %}
                            <twig:ListGroup:Item :label="zone.label" :muted="zone.value is null">
                                {%- if zone.value is not null -%}
                                    {{ zone.value }} {{ zone.unit }}
                                {%- else -%}
                                    <twig:NoValue />
                                {%- endif -%}
                            </twig:ListGroup:Item>
                        {% endfor %}
                    </twig:ListGroup>
                </twig:Card>
            </div>
        {% endif %}
    </div>

    {% if not has_anything %}
        <twig:EmptyState text="Rien à afficher pour l'instant&nbsp;: vos entraînements, votre charge et votre profil sportif apparaîtront ici." />
    {% endif %}
{% endblock %}
