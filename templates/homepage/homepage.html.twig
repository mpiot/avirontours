{% extends 'layouts/app.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block breadcrumb_items %}
    <twig:Breadcrumb:Item href="{{ path('my_space') }}">Mon espace</twig:Breadcrumb:Item>
    <twig:Breadcrumb:Item>Tableau de bord</twig:Breadcrumb:Item>
{% endblock %}

{% block page_title %}Tableau de bord{% endblock %}

{% block body %}
    {% set has_anything = logbookChart is not null
        or trainingsSportsChart is not null
        or physicalQualitiesChart is not null
        or app.user.physiology is not null
    %}

    <div class="row g-3">
        {% if logbookChart is not null %}
            <div class="col-12 col-xl-6">
                <twig:Card elevated class="h-100">
                    <twig:Card:Body>
                        <h2 class="fs-5">Mes sorties</h2>
                        <div class="app-chart">
                            {{ render_chart(logbookChart, { 'role': 'img', 'aria-label': 'Mes sorties' }) }}
                        </div>
                    </twig:Card:Body>
                </twig:Card>
            </div>
        {% endif %}

        {% if trainingsSportsChart is not null %}
            <div class="col-12 col-xl-6">
                <twig:Card elevated class="h-100">
                    <twig:Card:Body>
                        <h2 class="fs-5">Répartition des sports</h2>
                        <div class="app-chart">
                            {{ render_chart(trainingsSportsChart, { 'role': 'img', 'aria-label': 'Répartition des sports' }) }}
                        </div>
                    </twig:Card:Body>
                </twig:Card>
            </div>
        {% endif %}

        {% if physicalQualitiesChart is not null %}
            <div class="col-12 col-xl-6">
                <twig:Card elevated class="h-100">
                    <twig:Card:Body>
                        <h2 class="fs-5">Mes qualités physiques</h2>
                        <div class="app-chart">
                            {{ render_chart(physicalQualitiesChart, { 'role': 'img', 'aria-label': 'Mes qualités physiques' }) }}
                        </div>
                    </twig:Card:Body>
                </twig:Card>
            </div>
        {% endif %}

        {% if app.user.physiology is not null %}
            <div class="col-12 col-xl-6">
                <twig:Card elevated class="h-100">
                    <twig:Card:Body class="flex-grow-0">
                        <h2 class="fs-5">Ma physiologie</h2>
                    </twig:Card:Body>

                    {% set zones = [
                        { label: 'B0 - UT2', value: app.user.physiology.lightAerobicHeartRateRange, unit: 'bpm' },
                        { label: 'B1 - UT1', value: app.user.physiology.heavyAerobicHeartRateRange, unit: 'bpm' },
                        { label: 'B2 - AT', value: app.user.physiology.anaerobicThresholdHeartRateRange, unit: 'bpm' },
                        { label: 'B3 - TR', value: app.user.physiology.oxygenTransportationHeartRateRange, unit: 'bpm' },
                        { label: 'B5 - AN', value: app.user.physiology.anaerobicHeartRateRange, unit: 'bpm' },
                        { label: 'VO2max', value: app.user.physiology.maximumOxygenConsumption, unit: 'ml/min/kg' },
                    ] %}

                    <twig:ListGroup flush>
                        {% for zone in zones %}
                            <twig:ListGroup:Item :label="zone.label" :muted="zone.value is null">
                                {%- if zone.value is not null -%}
                                    {{ zone.value }} {{ zone.unit }}
                                {%- else -%}
                                    <twig:NoValue />
                                {%- endif -%}
                            </twig:ListGroup:Item>
                        {% endfor %}
                    </twig:ListGroup>
                </twig:Card>
            </div>
        {% endif %}
    </div>

    {% if not has_anything %}
        <twig:EmptyState text="Rien à afficher pour l'instant&nbsp;: vos sorties, vos entraînements et votre profil sportif apparaîtront ici." />
    {% endif %}
{% endblock %}
